//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_METRO_CAMMELL_DMU_1_BRG, 5559) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x12 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		dual_headed:					1;
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_METRO_CAMMELL_DMU_1_BRG); 
		introduction_date:				date(1956,1,1);
		vehicle_life: 					20;
		model_life:						47;
		length:							7;
		
		weight: 						32 ton;
		speed:							70 mph;
		power:							600 hp;
		tractive_effort_coefficient: 	0.1291454;
		cost_factor: 					0x13 nfo;
		running_cost_factor: 			0x12 nfo;
		
		badges: ["flag/GB", "power/diesel", "role/passenger"];
		
		variant_group: 			        ITEM_FAI_MU_METRO_CAMMELL_DMU_1;
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					39;
		loading_speed:					4;
		
	}
	graphics {
		default:						sw_METRO_CAMMELL_DMU_1_BRG_gfx_last;
		sound_effect:					sw_sfx_DIESEL;
		purchase:						spriteset_METRO_CAMMELL_DMU_1_BRG_purchase;
		create_effect:					vfx_DIESEL;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						spriteset_METRO_CAMMELL_DMU_1_BRG_wagon;
		length:							7;
		cargo_capacity:					42;
		loading_speed:					4;
		speed:							70 ;
	}
}
