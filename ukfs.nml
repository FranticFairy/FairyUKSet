//Sprite References & Switches
spriteset(spriteset_AM10_purchase, "gfx/MU/AM10.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_AM10, "gfx/MU/AM10.png") { template_fai_33(0, 16)}

spriteset(spriteset_AM10_wagon, "gfx/MU/AM10.png") { template_fai_33(0, 41)}

spriteset(spriteset_AM10_power, "gfx/MU/AM10.png") { template_fai_33(0, 41)}
switch(FEAT_TRAINS, SELF, sw_AM10_powerposition, position_in_vehid_chain - position_in_vehid_chain_from_end) {
 0..1: spriteset_AM10_power;
  spriteset_AM10_wagon;
}

switch(FEAT_TRAINS, SELF, sw_AM10_rearcheck, position_in_vehid_chain_from_end) {
  0: spriteset_AM10_power;
  spriteset_AM10_wagon;
}

switch(FEAT_TRAINS, SELF, sw_AM10_lencheck, num_vehs_in_vehid_chain){
    1..2 : sw_AM10_rearcheck;
    return sw_AM10_powerposition;
}

