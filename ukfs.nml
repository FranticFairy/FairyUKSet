//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_PLANET_SROL, 1000) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x2A nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_PLANET_SROL); 
		introduction_date:				date(1830,1,1);
		vehicle_life: 					25;
		model_life:						20;
		length:							3;
		
		weight: 						14 ton;
		speed:							30 mph;
		power:							120 hp;
		tractive_effort_coefficient: 	0.08746356;
		cost_factor: 					0x06 nfo;
		running_cost_factor: 			0x04 nfo;
		
		badges: ["flag/GB", "power/steam", "role/mixed"];
		
		variant_group: 			        ITEM_FAI_SL_PLANET;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_PLANET_SROL;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_PLANET_SROL_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_PLANET_SROL_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_PLANET_SROL_tender_0;
		length: 						2;
	}
}
