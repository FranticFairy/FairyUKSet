spriteset(spriteset_CLERESTORY_BUFFET_0_RCC_purchase, "gfx/PW/CLERESTORY_BUFFET_RCC.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_CLERESTORY_BUFFET_0_RCC, "gfx/PW/CLERESTORY_BUFFET_RCC.png") { template_fai_29(0, 16)}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_CLERESTORY_BUFFET_0_RCC, 7470) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_CLERESTORY_BUFFET_0_RCC); 
		introduction_date:				date(1880,1,1);
		model_life:						60;
		length:							7;
		
		weight: 						30 ton;
		speed:							80 mph;
		cost_factor: 					0x6A nfo;
		running_cost_factor: 			0x45 nfo;
		
		badges: ["flag/GB"];
		
		variant_group: 			        ITEM_FAI_PW_CLERESTORY_BUFFET_0;
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					15;
		loading_speed:					5;
		
	}
	graphics {
		default:						spriteset_CLERESTORY_BUFFET_0_RCC;
		purchase:						spriteset_CLERESTORY_BUFFET_0_RCC_purchase;
	}
}
