//Sprite References & Switches
spriteset(spriteset_PENDOLINO_purchase, "gfx/MU/PENDOLINO.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_PENDOLINO, "gfx/MU/PENDOLINO.png") { template_fai_33(0, 16)}

spriteset(spriteset_PENDOLINO_wagon, "gfx/MU/PENDOLINO.png") { template_fai_33(0, 41)}

spriteset(spriteset_PENDOLINO_power, "gfx/MU/PENDOLINO.png") { template_fai_33(0, 41)}
switch(FEAT_TRAINS, SELF, sw_PENDOLINO_powerposition, position_in_vehid_chain - position_in_vehid_chain_from_end) {
 0..1: spriteset_PENDOLINO_power;
  spriteset_PENDOLINO_wagon;
}

switch(FEAT_TRAINS, SELF, sw_PENDOLINO_rearcheck, position_in_vehid_chain_from_end) {
  0: spriteset_PENDOLINO_power;
  spriteset_PENDOLINO_wagon;
}

switch(FEAT_TRAINS, SELF, sw_PENDOLINO_lencheck, num_vehs_in_vehid_chain){
    1..2 : sw_PENDOLINO_rearcheck;
    return sw_PENDOLINO_powerposition;
}

