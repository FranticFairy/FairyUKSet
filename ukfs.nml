	dependent:	sw_IVATT_LMSC_randomflip;
	1: sw_IVATT_LMSC_flipcheck_steam_inv;
	1: sw_IVATT_LMSC_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_IVATT_LMSC, 589) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x12 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_IVATT_LMSC); 
		introduction_date:				date(1946,1,1);
		vehicle_life: 					36;
		model_life:						21;
		length:							6;
		
		weight: 						64 ton;
		speed:							70 mph;
		power:							800 hp;
		tractive_effort_coefficient: 	0.1211735;
		cost_factor: 					0x13 nfo;
		running_cost_factor: 			0x1C nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_passenger"];
		
		variant_group: 			        ITEM_FAI_SL_IVATT;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_IVATT_LMSC_randomflip;
		visual_effect_and_powered:		sw_IVATT_LMSC_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_IVATT_LMSC_purchase;
		create_effect:					vfx_STEAM;
	}
}
