# 1 "ukfs.pnml" 2
# 1 "src/CW/MIXED_1800.pnml" 1
spriteset(spriteset_EMPTY_1800_purchase, "gfx/CW/EMPTY.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_EMPTY_1800, "gfx/CW/EMPTY.png") { template_fai_17(0, 16)}
spriteset(spriteset_DEPOT_1800, "gfx/CW/EMPTY_DEPOT.png") { template_fai_17(0, 16)}

switch (FEAT_TRAINS, SELF, sw_MIXED_1800_read_cargo_count, 
                                            [STORE_TEMP(1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xBC]]) {
    return;
}

random_switch (FEAT_TRAINS, SELF, sw_MIXED_1800_randomvtt, TRIGGER_VEHICLE_ANY_LOAD) {
	1: sw_VAN_randomtexture;
	1: sw_5_PLANK_WAGON_compose;
	1: sw_FLATBED_SHORT_cargocheck;
}

random_switch (FEAT_TRAINS, SELF, sw_MIXED_1800_randomcovtarp, TRIGGER_VEHICLE_ANY_LOAD) {
	1: sw_5_PLANK_WAGON_compose;
	1: sw_GRAIN_TRUCK_randomtexture;
}

switch(FEAT_TRAINS, SELF, sw_MIXED_1800_REFRIGECHECK, cargo_classes & bitmask(CC_REFRIGERATED)) {
	bitmask(CC_REFRIGERATED): sw_VAN_randomtexture;
	return sw_MIXED_1800_randomvtt;
}

switch(FEAT_TRAINS, SELF, sw_MIXED_1800_LIVECHECK, cargo_type_in_veh){
	LVST : spriteset_LIVESTOCK_VAN ;
	sw_MIXED_1800_REFRIGECHECK ;
}

switch(FEAT_TRAINS, SELF, sw_MIXED_1800_COVEREDBULKCHECK, cargo_classes & bitmask(CC_COVERED)) {
	bitmask(CC_COVERED): return sw_MIXED_1800_randomcovtarp ;
	sw_5_PLANK_WAGON_compose;
}

switch(FEAT_TRAINS, SELF, sw_MIXED_1800_BULKCHECK, cargo_classes & bitmask(CC_BULK)) {
	bitmask(CC_BULK): sw_MIXED_1800_COVEREDBULKCHECK;
	return sw_MIXED_1800_LIVECHECK;
}

switch(FEAT_TRAINS, SELF, sw_MIXED_1800_LIQUIDCHECK, cargo_classes & bitmask(CC_LIQUID)) {
	bitmask(CC_LIQUID): return sw_TANKER_WAGON_randomtexture;
	sw_MIXED_1800_BULKCHECK ;
}

switch(FEAT_TRAINS, SELF, sw_MIXED_1800_checknextcargo, sw_MIXED_1800_read_cargo_count() ) {
	0: sw_spriteset_BRAKE_VAN_15T_randomtexture;
	sw_MIXED_1800_LIQUIDCHECK; 
}

switch(FEAT_TRAINS, SELF, sw_MIXED_1800_lastcheck, position_in_vehid_chain_from_end ) {
	0: sw_spriteset_BRAKE_VAN_15T_randomtexture;
	sw_MIXED_1800_LIQUIDCHECK; 
}

switch(FEAT_TRAINS, SELF, sw_MIXED_1800_LOADCHECK, cargo_count * (100 / cargo_capacity)){
	0..9	: spriteset_EMPTY_1800 ;
	10..100	: sw_MIXED_1800_lastcheck ;
}

switch(FEAT_TRAINS, SELF, sw_MIXED_1800_DEPOT, vehicle_is_in_depot){
	0	: sw_MIXED_1800_lastcheck ;
	1	: spriteset_DEPOT_1800 ;
}

