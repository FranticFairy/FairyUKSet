		running_cost_factor: 			0x68 nfo;
		
		badges: ["flag/GB", "power/dual_voltage", "role/express_passenger"];
		
		variant_group: 			        ITEM_FAI_MU_EUROSTAR_0;
		
		cargo_capacity: 				0;
