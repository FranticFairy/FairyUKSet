spriteset(spriteset_COVERED_CARRIAGE_TRUCK_RCC_purchase, "gfx/PW/COVERED_CARRIAGE_TRUCK_RCC.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_COVERED_CARRIAGE_TRUCK_RCC, "gfx/PW/COVERED_CARRIAGE_TRUCK_RCC.png") { template_fai_21(0, 16)}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_COVERED_CARRIAGE_TRUCK_RCC, 7344) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_COVERED_CARRIAGE_TRUCK_RCC); 
		introduction_date:				date(1890,1,1);
		model_life:						90;
		length:							5;
		
		weight: 						19 ton;
		speed:							75 mph;
		cost_factor: 					0x43 nfo;
		running_cost_factor: 			0x18 nfo;
		
		badges: ["flag/GB"];
		
		variant_group: 			        ITEM_FAI_PW_COVERED_CARRIAGE_TRUCK;
		
		refittable_cargo_classes:		bitmask(CC_MAIL,CC_EXPRESS,CC_ARMOURED);
		non_refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		default_cargo_type:				MAIL;
		cargo_capacity:					20;
		loading_speed:					4;
		
	}
	graphics {
		default:						spriteset_COVERED_CARRIAGE_TRUCK_RCC;
		purchase:						spriteset_COVERED_CARRIAGE_TRUCK_RCC_purchase;
	}
}
