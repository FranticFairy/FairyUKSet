//Sprite References & Switches
spriteset(spriteset_CLASS_25_2_purchase, "gfx/DL/CLASS_25_2.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_CLASS_25_2, "gfx/DL/CLASS_25_2.png") { template_fai_29(0, 16)}
spriteset(spriteset_CLASS_25_2_flip, "gfx/DL/CLASS_25_2.png") { template_fai_29_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_CLASS_25_2_flipcheck, vehicle_is_reversed){
	1: spriteset_CLASS_25_2;
	spriteset_CLASS_25_2_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_CLASS_25_2_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_CLASS_25_2_flip;
	spriteset_CLASS_25_2 ;
}

random_switch (FEAT_TRAINS, SELF, sw_CLASS_25_2_randomflip) {
	1: sw_CLASS_25_2_flipcheck;
	1: sw_CLASS_25_2_flipcheck_inv;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_DL_CLASS_25_2, 3129) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0E nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_CLASS_25_2); 
		introduction_date:				date(1961,1,1);
		vehicle_life: 					31;
		model_life:						26;
		length:							7;
		
		weight: 						74 ton;
		speed:							90 mph;
		power:							1250 hp;
		tractive_effort_coefficient: 	0.2578599;
		cost_factor: 					0x14 nfo;
		running_cost_factor: 			0x26 nfo;
		
		badges: ["flag/GB", "power/diesel", "role/mixed"];
		
		variant_group: 			        ITEM_FAI_DL_CLASS_25;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CLASS_25_2_randomflip;
		sound_effect:					sw_sfx_DIESEL;
		purchase:						spriteset_CLASS_25_2_purchase;
		create_effect:					vfx_DIESEL;
	}
}
