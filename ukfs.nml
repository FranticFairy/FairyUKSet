	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_INDUSTRIAL_SRML_randomflip_steam) {
	dependent:	sw_INDUSTRIAL_SRML_randomflip;
	1: sw_INDUSTRIAL_SRML_flipcheck_steam_inv;
	1: sw_INDUSTRIAL_SRML_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_INDUSTRIAL_SRML, 710) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x33 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_INDUSTRIAL_SRML); 
		introduction_date:				date(1890,1,1);
		vehicle_life: 					50;
		model_life:						80;
		length:							4;
		
		weight: 						35 ton;
		speed:							25 mph;
		power:							250 hp;
		tractive_effort_coefficient: 	0.2303207;
		cost_factor: 					0x07 nfo;
		running_cost_factor: 			0x07 nfo;
		
		badges: ["flag/GB", "power/steam", "role/shunting"];
		
		variant_group: 			        ITEM_FAI_SL_INDUSTRIAL;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_INDUSTRIAL_SRML_randomflip;
		visual_effect_and_powered:		sw_INDUSTRIAL_SRML_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_INDUSTRIAL_SRML_purchase;
		create_effect:					vfx_STEAM;
	}
}
