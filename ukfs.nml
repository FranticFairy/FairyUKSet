//Sprite References & Switches
spriteset(spriteset_SUBURBAN_III_MAROON_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_SUBURBAN_III_MAROON_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/SUBURBAN_III_MAROON.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_SUBURBAN_III_MAROON, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_SUBURBAN_III_MAROON, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/SUBURBAN_III_MAROON.png") { template_fai_29(0, 16)}
spriteset(spriteset_SUBURBAN_III_MAROON_flip, "gfx/32bpp.png") { template_fai_29_r(0, 16)}
alternative_sprites(spriteset_SUBURBAN_III_MAROON_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/SUBURBAN_III_MAROON.png") { template_fai_29_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_SUBURBAN_III_MAROON_flipcheck, vehicle_is_reversed){
	1: spriteset_SUBURBAN_III_MAROON;
	spriteset_SUBURBAN_III_MAROON_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_SUBURBAN_III_MAROON_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_SUBURBAN_III_MAROON_flip;
	spriteset_SUBURBAN_III_MAROON ;
}

random_switch (FEAT_TRAINS, SELF, sw_SUBURBAN_III_MAROON_randomflip) {
	1: sw_SUBURBAN_III_MAROON_flipcheck;
	1: sw_SUBURBAN_III_MAROON_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_SUBURBAN_III_MAROON_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_SUBURBAN_III_MAROON_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_SUBURBAN_III_MAROON_randomflip_steam) {
	dependent:	sw_SUBURBAN_III_MAROON_randomflip;
	1: sw_SUBURBAN_III_MAROON_flipcheck_steam_inv;
	1: sw_SUBURBAN_III_MAROON_flipcheck_steam;
}

