//Sprite References & Switches
spriteset(spriteset_CLASS_70_I_1_LNER_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_CLASS_70_I_1_LNER_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/EL/CLASS_70_I_1_LNER.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_CLASS_70_I_1_LNER, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_CLASS_70_I_1_LNER, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/EL/CLASS_70_I_1_LNER.png") { template_fai_29(0, 16)}
spriteset(spriteset_CLASS_70_I_1_LNER_flip, "gfx/32bpp.png") { template_fai_29_r(0, 16)}
alternative_sprites(spriteset_CLASS_70_I_1_LNER_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/EL/CLASS_70_I_1_LNER.png") { template_fai_29_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_CLASS_70_I_1_LNER_flipcheck, vehicle_is_reversed){
	1: spriteset_CLASS_70_I_1_LNER;
	spriteset_CLASS_70_I_1_LNER_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_CLASS_70_I_1_LNER_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_CLASS_70_I_1_LNER_flip;
	spriteset_CLASS_70_I_1_LNER ;
}

random_switch (FEAT_TRAINS, SELF, sw_CLASS_70_I_1_LNER_randomflip) {
	1: sw_CLASS_70_I_1_LNER_flipcheck;
	1: sw_CLASS_70_I_1_LNER_flipcheck_inv;
}

