spriteset(spriteset_BREL_APT_CC1_wagon, "gfx/MU/BREL_APT_CC1.png") { template_fai_33(0, 41)}

spriteset(spriteset_BREL_APT_CC1_power, "gfx/MU/BREL_APT_CC1.png") { template_fai_33(0, 41)}
switch(FEAT_TRAINS, SELF, sw_BREL_APT_CC1_powerposition, position_in_vehid_chain - position_in_vehid_chain_from_end) {
 0..1: spriteset_BREL_APT_CC1_power;
  spriteset_BREL_APT_CC1_wagon;
}

switch(FEAT_TRAINS, SELF, sw_BREL_APT_CC1_rearcheck, position_in_vehid_chain_from_end) {
  0: spriteset_BREL_APT_CC1_power;
  spriteset_BREL_APT_CC1_wagon;
}

switch(FEAT_TRAINS, SELF, sw_BREL_APT_CC1_lencheck, num_vehs_in_vehid_chain){
    1..2 : sw_BREL_APT_CC1_rearcheck;
    return sw_BREL_APT_CC1_powerposition;
}

