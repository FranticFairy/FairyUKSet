//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_STAR, 2792) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x12 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_STAR); 
		introduction_date:				date(1954,1,1);
		vehicle_life: 					35;
		model_life:						20;
		length:							7;
		
		weight: 						141 ton;
		speed:							70 mph;
		power:							1950 hp;
		tractive_effort_coefficient: 	0.1288175;
		cost_factor: 					0x23 nfo;
		running_cost_factor: 			0x39 nfo;
		
		badges: ["flag/GB", "power/steam", "role/express_freight"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_STAR;
		sound_effect:					sw_sfx_QR;
		purchase:						spriteset_STAR_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_STAR_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_STAR_tender_0;
		length: 						4;
	}
}
