	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0E nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_KING_ARTHUR); 
		introduction_date:				date(1918,1,1);
		vehicle_life: 					31;
		model_life:						44;
		length:							6;
		
		weight: 						138 ton;
		speed:							90 mph;
		power:							1150 hp;
		tractive_effort_coefficient: 	0.07837918;
		cost_factor: 					0x23 nfo;
		running_cost_factor: 			0x34 nfo;
		
		badges: ["flag/GB", "power/steam", "role/express_passenger"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_KING_ARTHUR;
		sound_effect:					sw_sfx_LMS;
		purchase:						spriteset_KING_ARTHUR_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_KING_ARTHUR_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_KING_ARTHUR_tender_0;
		length: 						3;
	}
}
