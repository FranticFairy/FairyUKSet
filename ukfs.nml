//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_MERCHANT_NAVY_1_MAROON, 2062) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0C nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_MERCHANT_NAVY_1_MAROON); 
		introduction_date:				date(1941,1,1);
		vehicle_life: 					30;
		model_life:						26;
		length:							7;
		
		weight: 						144 ton;
		speed:							110 mph;
		power:							2100 hp;
		tractive_effort_coefficient: 	0.1169218;
		cost_factor: 					0x24 nfo;
		running_cost_factor: 			0x69 nfo;
		
		badges: ["flag/GB", "power/steam", "role/passenger"];
		
		variant_group: 			        ITEM_FAI_SL_MERCHANT_NAVY_1;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_MERCHANT_NAVY_1_MAROON;
		sound_effect:					sw_sfx_QR;
		purchase:						spriteset_MERCHANT_NAVY_1_MAROON_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_MERCHANT_NAVY_1_MAROON_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_MERCHANT_NAVY_1_MAROON_tender_0;
		length: 						4;
	}
}
