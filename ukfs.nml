//Vehicle
item (FEAT_TRAINS, ITEM_FAI_CW_FLATBED_LARGE, 24021) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_FLATBED_LARGE); 
		introduction_date:				date(1910,1,1);
		model_life:						60;
		length:							8;
		
		weight: 						17 ton;
		speed:							55 mph;
		cost_factor: 					0x38 nfo;
		running_cost_factor: 			0x0E nfo;
		
		refittable_cargo_classes:		bitmask(CC_EXPRESS,CC_PIECE_GOODS);
		non_refittable_cargo_classes:		bitmask(CC_PASSENGERS,CC_COVERED);
		default_cargo_type:				GOOD;
        loading_speed:                  4;
		cargo_capacity:					20;
		
	}
	graphics {
		default:						sw_FLATBED_LARGE_cargocheck;
		purchase:						spriteset_FLATBED_LARGE_purchase;
	}
}
