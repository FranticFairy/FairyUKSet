switch(FEAT_TRAINS, SELF, sw_ARTICULATED_BUFFET_0_RCC_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_ARTICULATED_BUFFET_0_RCC; //All Gangways
	return spriteset_ARTICULATED_BUFFET_0_RCC_F;
}
switch(FEAT_TRAINS, SELF, sw_ARTICULATED_BUFFET_0_RCC_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_ARTICULATED_BUFFET_0_RCC_E; //All Gangways
	return spriteset_ARTICULATED_BUFFET_0_RCC_S;
}

