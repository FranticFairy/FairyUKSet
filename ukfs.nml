//Vehicle
item (FEAT_TRAINS, ITEM_FAI_CW_FLATBED_SHORT, 23902) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_FLATBED_SHORT); 
		introduction_date:				date(1865,1,1);
		model_life:						70;
		length:							4;
		
		weight: 						9 ton;
		speed:							45 mph;
		cost_factor: 					0x1A nfo;
		running_cost_factor: 			0x08 nfo;
		
		refittable_cargo_classes:		bitmask(CC_EXPRESS,CC_PIECE_GOODS);
		non_refittable_cargo_classes:		bitmask(CC_PASSENGERS,CC_COVERED);
		default_cargo_type:				GOOD;
        loading_speed:                  2;
		cargo_capacity:					10;
		
	}
	graphics {
		default:						sw_FLATBED_SHORT_cargocheck;
		purchase:						spriteset_FLATBED_SHORT_purchase;
	}
}
