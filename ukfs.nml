# 1 "src/CW/OPEN_WAGON.pnml" 1
//Sprite References & Switches
spriteset(spriteset_OPEN_WAGON_purchase, "gfx/CW/OPEN_WAGON.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_OPEN_WAGON, "gfx/CW/OPEN_WAGON.png") { template_fai_13(0, 16)}
spriteset(spriteset_OPEN_WAGON_R, "gfx/CW/OPEN_WAGON.png") { template_fai_13(0, 41)}
spriteset(spriteset_OPEN_WAGON_W, "gfx/CW/OPEN_WAGON.png") { template_fai_13(0, 66)}
spriteset(spriteset_OPEN_WAGON_G, "gfx/CW/OPEN_WAGON.png") { template_fai_13(0, 91)}

spriteset(spriteset_OPEN_WAGON_COAL_F, "gfx/CW/OPEN_WAGON_COAL.png") { template_fai_13(0, 41)}

switch(FEAT_TRAINS, SELF, sw_OPEN_WAGON_loadcheck_COAL, cargo_count * (100 / cargo_capacity)){
	51..100	: spriteset_OPEN_WAGON_COAL_F ;
}

random_switch (FEAT_TRAINS, SELF, sw_OPEN_WAGON_randomtexture, TRIGGER_VEHICLE_ANY_LOAD) {
	1: spriteset_OPEN_WAGON;
	1: spriteset_OPEN_WAGON_R;
	1: spriteset_OPEN_WAGON_W;
	1: spriteset_OPEN_WAGON_G;
}

switch (FEAT_TRAINS, SELF, sw_OPEN_WAGON_getwagon, STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)) {
    return sw_OPEN_WAGON_randomtexture;
}

switch (FEAT_TRAINS, SELF, sw_OPEN_WAGON_recolour_load, STORE_TEMP(switch_generic_recolour(), 0x100)) {
    return sw_OPEN_WAGON_loadcheck_COAL;
}

switch (FEAT_TRAINS, SELF, sw_OPEN_WAGON_compose, getbits(extra_callback_info1, 8, 8)) {
    0: return sw_OPEN_WAGON_getwagon;
    return sw_OPEN_WAGON_recolour_load;
}

