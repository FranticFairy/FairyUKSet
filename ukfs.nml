	1: sw_TRAM_LNER_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_TRAM_LNER, 779) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x2A nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_TRAM_LNER); 
		introduction_date:				date(1903,1,1);
		vehicle_life: 					33;
		model_life:						52;
		length:							4;
		
		weight: 						28 ton;
		speed:							30 mph;
		power:							200 hp;
		tractive_effort_coefficient: 	0.1457726;
		cost_factor: 					0x08 nfo;
		running_cost_factor: 			0x06 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_freight"];
		
		variant_group: 			        ITEM_FAI_SL_TRAM;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_TRAM_LNER_randomflip;
		visual_effect_and_powered:		sw_TRAM_LNER_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_TRAM_LNER_purchase;
		create_effect:					vfx_STEAM;
	}
}
