	spriteset_IVATT_LMSC_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_IVATT_LMSC_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_IVATT_LMSC_flip;
	spriteset_IVATT_LMSC ;
}

