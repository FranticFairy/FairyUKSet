		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_LADY_BRG); 
		introduction_date:				date(1859,1,1);
		vehicle_life: 					30;
		model_life:						11;
		length:							4;
		
		weight: 						46 ton;
		speed:							60 mph;
		power:							400 hp;
		tractive_effort_coefficient: 	0.09094942;
		cost_factor: 					0x0E nfo;
		running_cost_factor: 			0x0E nfo;
		
		badges: ["flag/GB", "power/steam", "role/passenger"];
		
		variant_group: 			        ITEM_FAI_SL_LADY;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_LADY_BRG;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_LADY_BRG_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_LADY_BRG_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_LADY_BRG_tender_0;
		length: 						3;
	}
}
