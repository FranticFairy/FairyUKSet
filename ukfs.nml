//Sprite References & Switches
spriteset(spriteset_KING_ARTHUR_RCC_purchase, "gfx/SL/KING_ARTHUR_RCC.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_KING_ARTHUR_RCC, "gfx/SL/KING_ARTHUR_RCC.png") { template_fai_24(0, 16)}
spriteset(spriteset_KING_ARTHUR_RCC_tender_0, "gfx/SL/KING_ARTHUR_RCC.png") { template_fai_13(0, 41)}

switch(FEAT_TRAINS, SELF, sw_KING_ARTHUR_RCC_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

