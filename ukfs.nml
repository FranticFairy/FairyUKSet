spriteset(spriteset_CLASS_20_0, "gfx/DL/CLASS_20.png") { template_fai_25(0, 16)}
spriteset(spriteset_CLASS_20_0_flip, "gfx/DL/CLASS_20.png") { template_fai_25_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_CLASS_20_0_flipcheck, vehicle_is_reversed){
	1: spriteset_CLASS_20_0;
	spriteset_CLASS_20_0_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_CLASS_20_0_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_CLASS_20_0_flip;
	spriteset_CLASS_20_0 ;
}

random_switch (FEAT_TRAINS, SELF, sw_CLASS_20_0_randomflip) {
	1: sw_CLASS_20_0_flipcheck;
	1: sw_CLASS_20_0_flipcheck_inv;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_DL_CLASS_20_0, 4185) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x11 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_CLASS_20_0); 
		introduction_date:				date(1957,1,1);
		vehicle_life: 					35;
		model_life:						0;
		length:							6;
		
		weight: 						73 ton;
		speed:							75 mph;
		power:							1000 hp;
		tractive_effort_coefficient: 	0.2613922;
		cost_factor: 					0x0F nfo;
		running_cost_factor: 			0x1B nfo;
		
		badges: ["flag/GB", "power/diesel", "role/freight"];
		
		variant_group: 			        ITEM_FAI_DL_CLASS_20;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CLASS_20_0_randomflip;
		sound_effect:					sw_sfx_DIESEL;
		purchase:						spriteset_CLASS_20_0_purchase;
		create_effect:					vfx_DIESEL;
	}
}
