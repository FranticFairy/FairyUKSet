spriteset(spriteset_CLASS_86_4_BRB_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_CLASS_86_4_BRB_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/EL/CLASS_86_4_BRB.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_CLASS_86_4_BRB, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_CLASS_86_4_BRB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/EL/CLASS_86_4_BRB.png") { template_fai_29(0, 16)}
spriteset(spriteset_CLASS_86_4_BRB_flip, "gfx/32bpp.png") { template_fai_29_r(0, 16)}
alternative_sprites(spriteset_CLASS_86_4_BRB_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/EL/CLASS_86_4_BRB.png") { template_fai_29_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_CLASS_86_4_BRB_flipcheck, vehicle_is_reversed){
	1: spriteset_CLASS_86_4_BRB;
	spriteset_CLASS_86_4_BRB_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_CLASS_86_4_BRB_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_CLASS_86_4_BRB_flip;
	spriteset_CLASS_86_4_BRB ;
}

random_switch (FEAT_TRAINS, SELF, sw_CLASS_86_4_BRB_randomflip) {
	1: sw_CLASS_86_4_BRB_flipcheck;
	1: sw_CLASS_86_4_BRB_flipcheck_inv;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_EL_CLASS_86_4_BRB, 4835) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0D nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						ELNG;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_CLASS_86_4_BRB); 
		introduction_date:				date(1965,1,1);
		vehicle_life: 					35;
		model_life:						0;
		length:							7;
		
		weight: 						81 ton;
		speed:							100 mph;
		power:							3600 hp;
		tractive_effort_coefficient: 	0.3237591;
		cost_factor: 					0x24 nfo;
		running_cost_factor: 			0x4D nfo;
		
		badges: ["flag/GB", "power/electric", "role/express_passenger"];
		
		variant_group: 			        ITEM_FAI_EL_CLASS_86_4;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CLASS_86_4_BRB_randomflip;
		sound_effect:					sw_sfx_EL1;
		purchase:						spriteset_CLASS_86_4_BRB_purchase;
		create_effect:					vfx_ohle;
	}
}
