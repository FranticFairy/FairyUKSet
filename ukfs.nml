item (FEAT_TRAINS, ITEM_FAI_MU_VOYAGER_CC1, 6062) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0A nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		dual_headed:					1;
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_VOYAGER_CC1); 
		introduction_date:				date(2000,1,1);
		vehicle_life: 					25;
		model_life:						0;
		length:							8;
		
		weight: 						43 ton;
		speed:							125 mph;
		power:							3000 hp;
		tractive_effort_coefficient: 	0.1874703;
		cost_factor: 					0x34 nfo;
		running_cost_factor: 			0x75 nfo;
		
		badges: ["flag/GB", "power/diesel", "role/express_passenger"];
		
		variant_group: 			        ITEM_FAI_MU_VOYAGER;
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					42;
		loading_speed:					4;
		
	}
	graphics {
		default:						spriteset_VOYAGER_CC1;
		sound_effect:					sw_sfx_VOYAGER;
		purchase:						spriteset_VOYAGER_CC1_purchase;
		create_effect:					vfx_DIESEL;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						spriteset_VOYAGER_CC1_wagon;
		length:							8;
		cargo_capacity:					60;
		loading_speed:					4;
		speed:							125 ;
	}
}
