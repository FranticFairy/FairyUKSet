# 1 "src/DL/CLASS_66_0_BRG.pnml" 1
//Sprite References & Switches
spriteset(spriteset_CLASS_66_0_BRG_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_CLASS_66_0_BRG_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/DL/CLASS_66_BRG.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_CLASS_66_0_BRG, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_CLASS_66_0_BRG, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/DL/CLASS_66_BRG.png") { template_fai_33(0, 16)}
spriteset(spriteset_CLASS_66_0_BRG_flip, "gfx/32bpp.png") { template_fai_33_r(0, 16)}
alternative_sprites(spriteset_CLASS_66_0_BRG_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/DL/CLASS_66_BRG.png") { template_fai_33_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_CLASS_66_0_BRG_flipcheck, vehicle_is_reversed){
	1: spriteset_CLASS_66_0_BRG;
	spriteset_CLASS_66_0_BRG_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_CLASS_66_0_BRG_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_CLASS_66_0_BRG_flip;
	spriteset_CLASS_66_0_BRG ;
}

random_switch (FEAT_TRAINS, SELF, sw_CLASS_66_0_BRG_randomflip) {
	1: sw_CLASS_66_0_BRG_flipcheck;
	1: sw_CLASS_66_0_BRG_flipcheck_inv;
}

