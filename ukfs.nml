		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_EUROSTAR_0_BRB); 
		introduction_date:				date(1992,1,1);
		vehicle_life: 					24;
		model_life:						0;
		length:							8;
		
		weight: 						69 ton;
		speed:							186 mph;
		power:							16400 hp;
		tractive_effort_coefficient: 	0.2580597;
