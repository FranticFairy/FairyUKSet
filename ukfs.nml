spriteset(spriteset_CLASS_325_MAROON_purchase, "gfx/32bpp.png") { template_fai_purchase_mu(0, 0)}
alternative_sprites(spriteset_CLASS_325_MAROON_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/CLASS_325_MAROON.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_CLASS_325_MAROON, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_CLASS_325_MAROON, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/CLASS_325_MAROON.png") { template_fai_33(0, 16)}

spriteset(spriteset_CLASS_325_MAROON_wagon, "gfx/32bpp.png") { template_fai_33(0, 41)}
alternative_sprites(spriteset_CLASS_325_MAROON_wagon, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/CLASS_325_MAROON.png") { template_fai_33(0, 41)}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_CLASS_325_MAROON, 6689) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0D nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		dual_headed:					1;
		
		track_type:						NBAZ;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_CLASS_325_MAROON); 
		introduction_date:				date(1995,1,1);
		vehicle_life: 					28;
		model_life:						0;
		length:							8;
		
		weight: 						41 ton;
		speed:							100 mph;
		power:							1300 hp;
		tractive_effort_coefficient: 	0.1642608;
		cost_factor: 					0x15 nfo;
		running_cost_factor: 			0x1E nfo;
		
		badges: ["flag/GB", "power/dual_voltage", "role/mail"];
		
		variant_group: 			        ITEM_FAI_MU_CLASS_325;
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				MAIL;
		cargo_capacity:					30;
		loading_speed:					3;
		
	}
	graphics {
		default:						spriteset_CLASS_325_MAROON;
		sound_effect:					sw_sfx_ELF;
		purchase:						spriteset_CLASS_325_MAROON_purchase;
		create_effect:					vfx_dual_voltage;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						spriteset_CLASS_325_MAROON_wagon;
		length:							8;
		cargo_capacity:					30;
		loading_speed:					3;
		speed:							100 ;
	}
}
