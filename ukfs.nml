		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_CLASS_23_1); 
		introduction_date:				date(1959,1,1);
		vehicle_life: 					26;
		model_life:						20;
		length:							7;
		
		weight: 						75 ton;
		speed:							75 mph;
		power:							1100 hp;
		tractive_effort_coefficient: 	0.262585;
		cost_factor: 					0x10 nfo;
		running_cost_factor: 			0x1D nfo;
		
		badges: ["flag/GB", "power/diesel", "role/passenger"];
		
		variant_group: 			        ITEM_FAI_DL_CLASS_23;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CLASS_23_1_randomflip;
		sound_effect:					sw_sfx_DELTIC;
		purchase:						spriteset_CLASS_23_1_purchase;
		create_effect:					vfx_DIESEL;
	}
}
