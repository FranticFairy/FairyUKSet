# 1 "src/SL/MIDLANDER_SRML.pnml" 1
//Sprite References & Switches
spriteset(spriteset_MIDLANDER_SRML_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_MIDLANDER_SRML_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/JINTY_SRML.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_MIDLANDER_SRML, "gfx/32bpp.png") { template_fai_21(0, 16)}
alternative_sprites(spriteset_MIDLANDER_SRML, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/JINTY_SRML.png") { template_fai_21(0, 16)}
spriteset(spriteset_MIDLANDER_SRML_flip, "gfx/32bpp.png") { template_fai_21_r(0, 16)}
alternative_sprites(spriteset_MIDLANDER_SRML_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/JINTY_SRML.png") { template_fai_21_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_MIDLANDER_SRML_flipcheck, vehicle_is_reversed){
	1: spriteset_MIDLANDER_SRML;
	spriteset_MIDLANDER_SRML_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_MIDLANDER_SRML_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_MIDLANDER_SRML_flip;
	spriteset_MIDLANDER_SRML ;
}

random_switch (FEAT_TRAINS, SELF, sw_MIDLANDER_SRML_randomflip) {
	1: sw_MIDLANDER_SRML_flipcheck;
	1: sw_MIDLANDER_SRML_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_MIDLANDER_SRML_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_MIDLANDER_SRML_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_MIDLANDER_SRML_randomflip_steam) {
	dependent:	sw_MIDLANDER_SRML_randomflip;
	1: sw_MIDLANDER_SRML_flipcheck_steam_inv;
	1: sw_MIDLANDER_SRML_flipcheck_steam;
}

