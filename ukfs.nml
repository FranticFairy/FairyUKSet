spriteset(spriteset_JINTY_BRG_flip, "gfx/32bpp.png") { template_fai_21_r(0, 16)}
alternative_sprites(spriteset_JINTY_BRG_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/JINTY_BRG.png") { template_fai_21_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_JINTY_BRG_flipcheck, vehicle_is_reversed){
	1: spriteset_JINTY_BRG;
	spriteset_JINTY_BRG_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_JINTY_BRG_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_JINTY_BRG_flip;
	spriteset_JINTY_BRG ;
}

random_switch (FEAT_TRAINS, SELF, sw_JINTY_BRG_randomflip) {
	1: sw_JINTY_BRG_flipcheck;
	1: sw_JINTY_BRG_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_JINTY_BRG_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_JINTY_BRG_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_JINTY_BRG_randomflip_steam) {
	dependent:	sw_JINTY_BRG_randomflip;
	1: sw_JINTY_BRG_flipcheck_steam_inv;
	1: sw_JINTY_BRG_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_JINTY_BRG, 274) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x1C nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_JINTY_BRG); 
		introduction_date:				date(1924,1,1);
		vehicle_life: 					40;
		model_life:						43;
		length:							5;
		
		weight: 						49 ton;
		speed:							45 mph;
		power:							500 hp;
		tractive_effort_coefficient: 	0.1915869;
		cost_factor: 					0x0F nfo;
		running_cost_factor: 			0x10 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_mixed"];
		
		variant_group: 			        ITEM_FAI_SL_JINTY;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_JINTY_BRG_randomflip;
		visual_effect_and_powered:		sw_JINTY_BRG_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_JINTY_BRG_purchase;
		create_effect:					vfx_STEAM;
	}
}
