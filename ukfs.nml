//Sprite References & Switches
spriteset(spriteset_LMS2P_BLK_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_LMS2P_BLK_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/LMS2P_BLK.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_LMS2P_BLK, "gfx/32bpp.png") { template_fai_21(0, 16)}
alternative_sprites(spriteset_LMS2P_BLK, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/LMS2P_BLK.png") { template_fai_21(0, 16)}
spriteset(spriteset_LMS2P_BLK_tender_0, "gfx/32bpp.png") { template_fai_12(0, 41)}
alternative_sprites(spriteset_LMS2P_BLK_tender_0, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/LMS2P_BLK.png") { template_fai_12(0, 41)}

switch(FEAT_TRAINS, SELF, sw_LMS2P_BLK_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

