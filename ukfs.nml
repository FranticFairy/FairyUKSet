spriteset(spriteset_WORKHORSE_LMSC_flip, "gfx/32bpp.png") { template_fai_29_r(0, 16)}
alternative_sprites(spriteset_WORKHORSE_LMSC_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/WORKHORSE_LMSC.png") { template_fai_29_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_WORKHORSE_LMSC_flipcheck, vehicle_is_reversed){
	1: spriteset_WORKHORSE_LMSC;
	spriteset_WORKHORSE_LMSC_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_WORKHORSE_LMSC_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_WORKHORSE_LMSC_flip;
	spriteset_WORKHORSE_LMSC ;
}

random_switch (FEAT_TRAINS, SELF, sw_WORKHORSE_LMSC_randomflip) {
	1: sw_WORKHORSE_LMSC_flipcheck;
	1: sw_WORKHORSE_LMSC_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_WORKHORSE_LMSC_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_WORKHORSE_LMSC_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_WORKHORSE_LMSC_randomflip_steam) {
	dependent:	sw_WORKHORSE_LMSC_randomflip;
	1: sw_WORKHORSE_LMSC_flipcheck_steam_inv;
	1: sw_WORKHORSE_LMSC_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_WORKHORSE_LMSC, 924) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x14 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_WORKHORSE_LMSC); 
		introduction_date:				date(1925,1,1);
		vehicle_life: 					40;
		model_life:						19;
		length:							7;
		
		weight: 						89 ton;
		speed:							65 mph;
		power:							650 hp;
		tractive_effort_coefficient: 	0.1318505;
		cost_factor: 					0x0F nfo;
		running_cost_factor: 			0x12 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_freight"];
		
		variant_group: 			        ITEM_FAI_SL_WORKHORSE;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_WORKHORSE_LMSC_randomflip;
		visual_effect_and_powered:		sw_WORKHORSE_LMSC_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_WORKHORSE_LMSC_purchase;
		create_effect:					vfx_STEAM;
	}
}
