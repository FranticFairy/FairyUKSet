spriteset(spriteset_DOCKSHUNTER_LNER_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_DOCKSHUNTER_LNER_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/DOCKSHUNTER_LNER.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_DOCKSHUNTER_LNER, "gfx/32bpp.png") { template_fai_17(0, 16)}
alternative_sprites(spriteset_DOCKSHUNTER_LNER, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/DOCKSHUNTER_LNER.png") { template_fai_17(0, 16)}
spriteset(spriteset_DOCKSHUNTER_LNER_flip, "gfx/32bpp.png") { template_fai_17_r(0, 16)}
alternative_sprites(spriteset_DOCKSHUNTER_LNER_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/DOCKSHUNTER_LNER.png") { template_fai_17_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_DOCKSHUNTER_LNER_flipcheck, vehicle_is_reversed){
	1: spriteset_DOCKSHUNTER_LNER;
	spriteset_DOCKSHUNTER_LNER_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_DOCKSHUNTER_LNER_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_DOCKSHUNTER_LNER_flip;
	spriteset_DOCKSHUNTER_LNER ;
}

random_switch (FEAT_TRAINS, SELF, sw_DOCKSHUNTER_LNER_randomflip) {
	1: sw_DOCKSHUNTER_LNER_flipcheck;
	1: sw_DOCKSHUNTER_LNER_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_DOCKSHUNTER_LNER_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_DOCKSHUNTER_LNER_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_DOCKSHUNTER_LNER_randomflip_steam) {
	dependent:	sw_DOCKSHUNTER_LNER_randomflip;
	1: sw_DOCKSHUNTER_LNER_flipcheck_steam_inv;
	1: sw_DOCKSHUNTER_LNER_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_DOCKSHUNTER_LNER, 731) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x33 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_DOCKSHUNTER_LNER); 
		introduction_date:				date(1921,1,1);
		vehicle_life: 					40;
		model_life:						36;
		length:							4;
		
		weight: 						33 ton;
		speed:							25 mph;
		power:							250 hp;
		tractive_effort_coefficient: 	0.2009895;
		cost_factor: 					0x07 nfo;
		running_cost_factor: 			0x07 nfo;
		
		badges: ["flag/GB", "power/steam", "role/shunting"];
		
		variant_group: 			        ITEM_FAI_SL_DOCKSHUNTER;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_DOCKSHUNTER_LNER_randomflip;
		visual_effect_and_powered:		sw_DOCKSHUNTER_LNER_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_DOCKSHUNTER_LNER_purchase;
		create_effect:					vfx_STEAM;
	}
}
