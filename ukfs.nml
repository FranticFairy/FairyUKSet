//Sprite References & Switches
spriteset(spriteset_STREAK_0_NBR_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_STREAK_0_NBR_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/STREAK_NBR.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_STREAK_0_NBR, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_STREAK_0_NBR, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/STREAK_NBR.png") { template_fai_29(0, 16)}
spriteset(spriteset_STREAK_0_NBR_tender_0, "gfx/32bpp.png") { template_fai_16(0, 41)}
alternative_sprites(spriteset_STREAK_0_NBR_tender_0, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/STREAK_NBR.png") { template_fai_16(0, 41)}

switch(FEAT_TRAINS, SELF, sw_STREAK_0_NBR_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

