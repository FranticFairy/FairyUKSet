alternative_sprites(spriteset_AM10_1_BRB_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/AM10_1_BRB.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_AM10_1_BRB, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_AM10_1_BRB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/AM10_1_BRB.png") { template_fai_33(0, 16)}

spriteset(spriteset_AM10_1_BRB_wagon, "gfx/32bpp.png") { template_fai_33(0, 41)}
alternative_sprites(spriteset_AM10_1_BRB_wagon, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/AM10_1_BRB.png") { template_fai_33(0, 41)}

spriteset(spriteset_AM10_1_BRB_power, "gfx/32bpp.png") { template_fai_33(0, 41)}
alternative_sprites(spriteset_AM10_1_BRB_power, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/AM10_1_BRB.png") { template_fai_33(0, 41)}
switch(FEAT_TRAINS, SELF, sw_AM10_1_BRB_powerposition, position_in_vehid_chain - position_in_vehid_chain_from_end) {
 0..1: spriteset_AM10_1_BRB_power;
  spriteset_AM10_1_BRB_wagon;
}

switch(FEAT_TRAINS, SELF, sw_AM10_1_BRB_rearcheck, position_in_vehid_chain_from_end) {
  0: spriteset_AM10_1_BRB_power;
  spriteset_AM10_1_BRB_wagon;
}

switch(FEAT_TRAINS, SELF, sw_AM10_1_BRB_lencheck, num_vehs_in_vehid_chain){
    1..2 : sw_AM10_1_BRB_rearcheck;
    return sw_AM10_1_BRB_powerposition;
}

