		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x33 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_CLASS_08_3_YLW); 
		introduction_date:				date(1939,1,1);
		vehicle_life: 					40;
		model_life:						0;
		length:							4;
		
		weight: 						50 ton;
		speed:							25 mph;
		power:							350 hp;
		tractive_effort_coefficient: 	0.3163265;
		cost_factor: 					0x07 nfo;
		running_cost_factor: 			0x07 nfo;
		
		badges: ["flag/GB", "power/diesel", "role/shunting"];
		
		variant_group: 			        ITEM_FAI_DL_CLASS_08_3;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CLASS_08_3_YLW_randomflip;
		sound_effect:					sw_sfx_GRONK;
		purchase:						spriteset_CLASS_08_3_YLW_purchase;
		create_effect:					vfx_DIESEL;
	}
}
