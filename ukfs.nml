spriteset(spriteset_METROPOLITAN_G_CLD_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_METROPOLITAN_G_CLD_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/METROPOLITAN_G_CLD.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_METROPOLITAN_G_CLD, "gfx/32bpp.png") { template_fai_25(0, 16)}
alternative_sprites(spriteset_METROPOLITAN_G_CLD, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/METROPOLITAN_G_CLD.png") { template_fai_25(0, 16)}
spriteset(spriteset_METROPOLITAN_G_CLD_flip, "gfx/32bpp.png") { template_fai_25_r(0, 16)}
alternative_sprites(spriteset_METROPOLITAN_G_CLD_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/METROPOLITAN_G_CLD.png") { template_fai_25_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_METROPOLITAN_G_CLD_flipcheck, vehicle_is_reversed){
	1: spriteset_METROPOLITAN_G_CLD;
	spriteset_METROPOLITAN_G_CLD_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_METROPOLITAN_G_CLD_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_METROPOLITAN_G_CLD_flip;
	spriteset_METROPOLITAN_G_CLD ;
}

random_switch (FEAT_TRAINS, SELF, sw_METROPOLITAN_G_CLD_randomflip) {
	1: sw_METROPOLITAN_G_CLD_flipcheck;
	1: sw_METROPOLITAN_G_CLD_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_METROPOLITAN_G_CLD_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_METROPOLITAN_G_CLD_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_METROPOLITAN_G_CLD_randomflip_steam) {
	dependent:	sw_METROPOLITAN_G_CLD_randomflip;
	1: sw_METROPOLITAN_G_CLD_flipcheck_steam_inv;
	1: sw_METROPOLITAN_G_CLD_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_METROPOLITAN_G_CLD, 523) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x19 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_METROPOLITAN_G_CLD); 
		introduction_date:				date(1915,1,1);
		vehicle_life: 					20;
		model_life:						28;
		length:							6;
		
		weight: 						72 ton;
		speed:							50 mph;
		power:							900 hp;
		tractive_effort_coefficient: 	0.1289683;
		cost_factor: 					0x13 nfo;
		running_cost_factor: 			0x1C nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_passenger"];
		
		variant_group: 			        ITEM_FAI_SL_METROPOLITAN_G;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_METROPOLITAN_G_CLD_randomflip;
		visual_effect_and_powered:		sw_METROPOLITAN_G_CLD_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_METROPOLITAN_G_CLD_purchase;
		create_effect:					vfx_STEAM;
	}
}
