spriteset(spriteset_SPEEDLINK_OPEN_2R, "gfx/CW/SPEEDLINK_OPEN.png") { template_fai_25(0, 91)}

spriteset(spriteset_SPEEDLINK_OPEN_GOOD1, "gfx/CW/SPEEDLINK_OPEN_LOADS.png") { template_fai_25(0, 41)}
spriteset(spriteset_SPEEDLINK_OPEN_GOOD2, "gfx/CW/SPEEDLINK_OPEN_LOADS.png") { template_fai_25(0, 66)}

spriteset(spriteset_SPEEDLINK_OPEN_WDPR, "gfx/CW/SPEEDLINK_OPEN_LOADS.png") { template_fai_25(0, 91)}
spriteset(spriteset_SPEEDLINK_OPEN_METL, "gfx/CW/SPEEDLINK_OPEN_LOADS.png") { template_fai_25(0, 116)}

spriteset(spriteset_SPEEDLINK_OPEN_WOODH, "gfx/CW/SPEEDLINK_OPEN_LOADS.png") { template_fai_25(0, 141)}
spriteset(spriteset_SPEEDLINK_OPEN_WOODF, "gfx/CW/SPEEDLINK_OPEN_LOADS.png") { template_fai_25(0, 166)}

random_switch (FEAT_TRAINS, SELF, sw_SPEEDLINK_OPEN_randomtexture, TRIGGER_VEHICLE_ANY_LOAD) {
	1: spriteset_SPEEDLINK_OPEN;
	1: spriteset_SPEEDLINK_OPEN_R;
}

random_switch (FEAT_TRAINS, SELF, sw_SPEEDLINK_OPEN_randomtexture_GOOD, TRIGGER_VEHICLE_ANY_LOAD) {
	1: spriteset_SPEEDLINK_OPEN_GOOD1;
	1: spriteset_SPEEDLINK_OPEN_GOOD2;
}

switch(FEAT_TRAINS, SELF, sw_SPEEDLINK_OPEN_loadcheck_WOOD, cargo_count * (100 / cargo_capacity)){
	26..70	: spriteset_SPEEDLINK_OPEN_WOODH ;
	71..100	: spriteset_SPEEDLINK_OPEN_WOODF ;
}

switch(FEAT_TRAINS, SELF, sw_SPEEDLINK_OPEN_loadcheck_METL, cargo_count * (100 / cargo_capacity)){
	51..100	: spriteset_SPEEDLINK_OPEN_METL ;
}

switch(FEAT_TRAINS, SELF, sw_SPEEDLINK_OPEN_loadcheck_WDPR, cargo_count * (100 / cargo_capacity)){
	51..100	: spriteset_SPEEDLINK_OPEN_WDPR ;
}

switch(FEAT_TRAINS, SELF, sw_SPEEDLINK_OPEN_loadcheck_GOOD, cargo_count * (100 / cargo_capacity)){
	51..100	: sw_SPEEDLINK_OPEN_randomtexture_GOOD ;
}


switch(FEAT_TRAINS, SELF, sw_SPEEDLINK_WAGON_cargocheck, cargo_type_in_veh){
	GOOD : sw_SPEEDLINK_OPEN_loadcheck_GOOD ;
	WDPR : sw_SPEEDLINK_OPEN_loadcheck_WDPR ;
	STEL : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	IRON : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	METL : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	COPR : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	STAL : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	STCB : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	STSE : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	STSH : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	STST : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	STWR : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	PIPE : sw_SPEEDLINK_OPEN_loadcheck_METL ;
	WOOD : sw_SPEEDLINK_OPEN_loadcheck_WOOD ;
	sw_SPEEDLINK_OPEN_loadcheck_GOOD ;
}

switch(FEAT_TRAINS, SELF, sw_SPEEDLINK_WAGON_spritestack, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]){
	0 : sw_SPEEDLINK_OPEN_randomtexture ;
	1 : sw_SPEEDLINK_WAGON_cargocheck ;
}

