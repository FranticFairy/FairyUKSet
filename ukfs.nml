	1: sw_MIDLANDER_SROL_flipcheck_steam_inv;
	1: sw_MIDLANDER_SROL_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_MIDLANDER_SROL, 253) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x1C nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_MIDLANDER_SROL); 
		introduction_date:				date(1899,1,1);
		vehicle_life: 					40;
		model_life:						27;
		length:							5;
		
		weight: 						49 ton;
		speed:							45 mph;
		power:							500 hp;
		tractive_effort_coefficient: 	0.1478551;
		cost_factor: 					0x0F nfo;
		running_cost_factor: 			0x10 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_mixed"];
		
		variant_group: 			        ITEM_FAI_SL_MIDLANDER;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_MIDLANDER_SROL_randomflip;
		visual_effect_and_powered:		sw_MIDLANDER_SROL_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_MIDLANDER_SROL_purchase;
		create_effect:					vfx_STEAM;
	}
}
