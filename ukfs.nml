//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_ARTICULATED_BUFFET_1_CLD, 7854) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_ARTICULATED_BUFFET_1_CLD); 
		introduction_date:				date(1925,1,1);
		model_life:						30;
		length:							7;
		
		weight: 						55 ton;
		speed:							120 mph;
		cost_factor: 					0xFF nfo;
		running_cost_factor: 			0x87 nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		variant_group: 			        ITEM_FAI_PW_ARTICULATED_BUFFET_1;
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					15;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_articulated_PW_ARTICULATED_BUFFET_1_CLD;
        articulated_part:               sw_articulation_PW_ARTICULATED_BUFFET_1_CLD;
		purchase:						spriteset_ARTICULATED_BUFFET_1_CLD_purchase;
	}
}
