switch(FEAT_TRAINS, SELF, sw_SUBURBAN_CARRIAGE_2_BRB_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
