//Vehicle
item (FEAT_TRAINS, ITEM_FAI_DL_CLASS_D162_BLK, 3452) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0E nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_CLASS_D162_BLK); 
		introduction_date:				date(1950,1,1);
		vehicle_life: 					25;
		model_life:						20;
		length:							8;
		
		weight: 						133 ton;
		speed:							90 mph;
		power:							1300 hp;
		tractive_effort_coefficient: 	0.1634188;
		cost_factor: 					0x26 nfo;
		running_cost_factor: 			0x38 nfo;
		
		badges: ["flag/GB", "power/diesel", "role/passenger"];
		
		variant_group: 			        ITEM_FAI_DL_CLASS_D162;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CLASS_D162_BLK_randomflip;
		sound_effect:					sw_sfx_GRONK;
		purchase:						spriteset_CLASS_D162_BLK_purchase;
		create_effect:					vfx_DIESEL;
	}
}
