		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_SOUTHERN_EMU_2_BRG); 
		introduction_date:				date(1937,1,1);
		vehicle_life: 					25;
		model_life:						35;
		length:							8;
		
		weight: 						38 ton;
		speed:							75 mph;
		power:							900 hp;
		tractive_effort_coefficient: 	0.1329216;
		cost_factor: 					0x17 nfo;
		running_cost_factor: 			0x19 nfo;
		
