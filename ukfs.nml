		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x1C nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_RAILMOTOR); 
		introduction_date:				date(1903,1,1);
		vehicle_life: 					22;
		model_life:						32;
		length:							7;
		
		weight: 						36 ton;
		speed:							45 mph;
		power:							150 hp;
		tractive_effort_coefficient: 	0.05385487;
		cost_factor: 					0x0B nfo;
		running_cost_factor: 			0x06 nfo;
		
		badges: ["flag/GB", "power/steam", "role/passenger"];
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
