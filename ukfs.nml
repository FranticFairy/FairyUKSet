	dependent:	sw_DOCKWORKER_SRML_randomflip;
	1: sw_DOCKWORKER_SRML_flipcheck_steam_inv;
	1: sw_DOCKWORKER_SRML_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_DOCKWORKER_SRML, 854) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x17 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_DOCKWORKER_SRML); 
		introduction_date:				date(1909,1,1);
		vehicle_life: 					40;
		model_life:						46;
		length:							7;
		
		weight: 						86 ton;
		speed:							55 mph;
		power:							600 hp;
		tractive_effort_coefficient: 	0.1791647;
		cost_factor: 					0x0E nfo;
		running_cost_factor: 			0x12 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_freight"];
		
		variant_group: 			        ITEM_FAI_SL_DOCKWORKER;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_DOCKWORKER_SRML_randomflip;
		visual_effect_and_powered:		sw_DOCKWORKER_SRML_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_DOCKWORKER_SRML_purchase;
		create_effect:					vfx_STEAM;
	}
}
