		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x11 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_CLASS_66_0_BRB); 
		introduction_date:				date(1998,1,1);
		vehicle_life: 					35;
		model_life:						0;
		length:							8;
		
		weight: 						128 ton;
		speed:							75 mph;
		power:							3300 hp;
		tractive_effort_coefficient: 	0.3284439;
		cost_factor: 					0x2A nfo;
		running_cost_factor: 			0x3E nfo;
		
		badges: ["flag/GB", "power/diesel", "role/heavy_freight"];
		
		variant_group: 			        ITEM_FAI_DL_CLASS_66_0;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CLASS_66_0_BRB_randomflip;
		sound_effect:					sw_sfx_DIESEL;
		purchase:						spriteset_CLASS_66_0_BRB_purchase;
		create_effect:					vfx_DIESEL;
	}
}
