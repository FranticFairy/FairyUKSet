//Sprite References & Switches
spriteset(spriteset_CLASS_55_0_SLV_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_CLASS_55_0_SLV_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/DL/CLASS_55_SLV.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_CLASS_55_0_SLV, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_CLASS_55_0_SLV, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/DL/CLASS_55_SLV.png") { template_fai_33(0, 16)}
spriteset(spriteset_CLASS_55_0_SLV_flip, "gfx/32bpp.png") { template_fai_33_r(0, 16)}
alternative_sprites(spriteset_CLASS_55_0_SLV_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/DL/CLASS_55_SLV.png") { template_fai_33_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_CLASS_55_0_SLV_flipcheck, vehicle_is_reversed){
	1: spriteset_CLASS_55_0_SLV;
	spriteset_CLASS_55_0_SLV_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_CLASS_55_0_SLV_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_CLASS_55_0_SLV_flip;
	spriteset_CLASS_55_0_SLV ;
}

random_switch (FEAT_TRAINS, SELF, sw_CLASS_55_0_SLV_randomflip) {
	1: sw_CLASS_55_0_SLV_flipcheck;
	1: sw_CLASS_55_0_SLV_flipcheck_inv;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_DL_CLASS_55_0_SLV, 3615) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0D nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_CLASS_55_0_SLV); 
		introduction_date:				date(1961,1,1);
		vehicle_life: 					32;
		model_life:						21;
		length:							8;
		
		weight: 						101 ton;
		speed:							100 mph;
		power:							3300 hp;
		tractive_effort_coefficient: 	0.2222671;
		cost_factor: 					0x43 nfo;
		running_cost_factor: 			0x6A nfo;
		
		badges: ["flag/GB", "power/diesel", "role/express_passenger"];
		
		variant_group: 			        ITEM_FAI_DL_CLASS_55_0;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CLASS_55_0_SLV_randomflip;
		sound_effect:					sw_sfx_DIESEL;
		purchase:						spriteset_CLASS_55_0_SLV_purchase;
		create_effect:					vfx_DIESEL;
	}
}
