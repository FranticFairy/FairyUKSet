//Sprite References & Switches
spriteset(spriteset_MOUSE_purchase, "gfx/DL/MOUSE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_MOUSE, "gfx/DL/MOUSE.png") { template_fai_29(0, 16)}
spriteset(spriteset_MOUSE_flip, "gfx/DL/MOUSE.png") { template_fai_29_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_MOUSE_flipcheck, vehicle_is_reversed){
	1: spriteset_MOUSE;
	spriteset_MOUSE_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_MOUSE_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_MOUSE_flip;
	spriteset_MOUSE ;
}

random_switch (FEAT_TRAINS, SELF, sw_MOUSE_randomflip) {
	1: sw_MOUSE_flipcheck;
	1: sw_MOUSE_flipcheck_inv;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_DL_MOUSE, 7071) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x11 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_MOUSE); 
		introduction_date:				date(1959,1,1);
		vehicle_life: 					25;
		model_life:						13;
		length:							7;
		
		weight: 						104 ton;
		speed:							75 mph;
		power:							1500 hp;
		tractive_effort_coefficient: 	0.1913265;
		cost_factor: 					0x12 nfo;
		running_cost_factor: 			0x23 nfo;
		
		badges: ["flag/GB", "power/diesel", "role/heavy_freight"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_MOUSE_randomflip;
		sound_effect:					sw_sfx_DIESEL;
		purchase:						spriteset_MOUSE_purchase;
		create_effect:					vfx_DIESEL;
	}
}
