//Sprite References & Switches
spriteset(spriteset_AVALANCHE_purchase, "gfx/DL/AVALANCHE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_AVALANCHE, "gfx/DL/AVALANCHE.png") { template_fai_33(0, 16)}
spriteset(spriteset_AVALANCHE_flip, "gfx/DL/AVALANCHE.png") { template_fai_33_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_AVALANCHE_flipcheck, vehicle_is_reversed){
	1: spriteset_AVALANCHE;
	spriteset_AVALANCHE_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_AVALANCHE_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_AVALANCHE_flip;
	spriteset_AVALANCHE ;
}

random_switch (FEAT_TRAINS, SELF, sw_AVALANCHE_randomflip) {
	1: sw_AVALANCHE_flipcheck;
	1: sw_AVALANCHE_flipcheck_inv;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_DL_AVALANCHE, 7119) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0E nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_AVALANCHE); 
		introduction_date:				date(1964,1,1);
		vehicle_life: 					25;
		model_life:						16;
		length:							8;
		
		weight: 						154 ton;
		speed:							90 mph;
		power:							2250 hp;
		tractive_effort_coefficient: 	0.148423;
		cost_factor: 					0x2E nfo;
		running_cost_factor: 			0x45 nfo;
		
		badges: ["flag/GB", "power/diesel", "role/heavy_freight"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_AVALANCHE_randomflip;
		sound_effect:					sw_sfx_DIESEL;
		purchase:						spriteset_AVALANCHE_purchase;
		create_effect:					vfx_DIESEL;
	}
}
