//Sprite References & Switches
spriteset(spriteset_ARTICULATE_BLK_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_ARTICULATE_BLK_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/DL/ARTICULATE_BLK.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_ARTICULATE_BLK, "gfx/32bpp.png") { template_fai_17(0, 16)}
alternative_sprites(spriteset_ARTICULATE_BLK, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/DL/ARTICULATE_BLK.png") { template_fai_17(0, 16)}
spriteset(spriteset_ARTICULATE_BLK_tender_0, "gfx/32bpp.png") { template_fai_16(0, 41)}
alternative_sprites(spriteset_ARTICULATE_BLK_tender_0, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/DL/ARTICULATE_BLK.png") { template_fai_16(0, 41)}

switch(FEAT_TRAINS, SELF, sw_ARTICULATE_BLK_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_DL_ARTICULATE_BLK, 7147) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x10 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_ARTICULATE_BLK); 
		introduction_date:				date(1961,1,1);
		vehicle_life: 					25;
		model_life:						11;
		length:							4;
		
		weight: 						140 ton;
		speed:							80 mph;
		power:							2000 hp;
		tractive_effort_coefficient: 	0.2332361;
		cost_factor: 					0x2A nfo;
		running_cost_factor: 			0x3C nfo;
		
		badges: ["flag/GB", "power/diesel", "role/heavy_freight"];
		
		variant_group: 			        ITEM_FAI_DL_ARTICULATE;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_ARTICULATE_BLK;
		sound_effect:					sw_sfx_DIESEL;
		purchase:						spriteset_ARTICULATE_BLK_purchase;
		create_effect:					vfx_DIESEL;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_ARTICULATE_BLK_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_ARTICULATE_BLK_tender_0;
		length: 						4;
	}
}
