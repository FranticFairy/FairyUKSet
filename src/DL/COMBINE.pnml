//Sprite References & Switches
spriteset(spriteset_COMBINE_purchase, "gfx/DL/COMBINE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_COMBINE, "gfx/DL/COMBINE.png") { template_fai_33(0, 16)}
spriteset(spriteset_COMBINE_flip, "gfx/DL/COMBINE.png") { template_fai_33_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_COMBINE_flipcheck, vehicle_is_reversed){
	1: spriteset_COMBINE;
	spriteset_COMBINE_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_COMBINE_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_COMBINE_flip;
	spriteset_COMBINE ;
}

random_switch (FEAT_TRAINS, SELF, sw_COMBINE_randomflip) {
	1: sw_COMBINE_flipcheck;
	1: sw_COMBINE_flipcheck_inv;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_DL_COMBINE, 7095) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x14 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_COMBINE); 
		introduction_date:				date(1967,1,1);
		vehicle_life: 					25;
		model_life:						14;
		length:							8;
		
		weight: 						110 ton;
		speed:							65 mph;
		power:							1750 hp;
		tractive_effort_coefficient: 	0.2411874;
		cost_factor: 					0x1C nfo;
		running_cost_factor: 			0x2D nfo;
		
		badges: ["flag/GB", "power/diesel", "role/heavy_freight"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_COMBINE_randomflip;
		sound_effect:					sw_sfx_DIESEL;
		purchase:						spriteset_COMBINE_purchase;
		create_effect:					vfx_DIESEL;
	}
}
