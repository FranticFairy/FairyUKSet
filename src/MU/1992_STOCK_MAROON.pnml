//Sprite References & Switches
spriteset(spriteset_1992_STOCK_MAROON_purchase, "gfx/32bpp.png") { template_fai_purchase_mu(0, 0)}
alternative_sprites(spriteset_1992_STOCK_MAROON_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/1992_STOCK_MAROON.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_1992_STOCK_MAROON, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_1992_STOCK_MAROON, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/1992_STOCK_MAROON.png") { template_fai_29(0, 16)}

spriteset(spriteset_1992_STOCK_MAROONB, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_1992_STOCK_MAROONB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/1992_STOCK_MAROON.png") { template_fai_29_mu(0, 16)}

