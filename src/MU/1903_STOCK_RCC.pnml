//Sprite References & Switches
spriteset(spriteset_1903_STOCK_RCC_purchase, "gfx/MU/1903_STOCK_RCC.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_1903_STOCK_RCC, "gfx/MU/1903_STOCK_RCC.png") { template_fai_29(0, 16)}

spriteset(spriteset_1903_STOCK_RCCB, "gfx/MU/1903_STOCK_RCC.png") { template_fai_29_mu(0, 16)}

spriteset(spriteset_1903_STOCK_RCC_wagon, "gfx/MU/1903_STOCK_RCC.png") { template_fai_29(0, 41)}

switch(FEAT_TRAINS, SELF, sw_1903_STOCK_RCC_gfx_last, vehicle_is_flipped){
    1:	spriteset_1903_STOCK_RCCB;
	spriteset_1903_STOCK_RCC;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_1903_STOCK_RCC, 6952) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x20 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		dual_headed:					1;
		
		track_type:						NBA4;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_1903_STOCK_RCC); 
		introduction_date:				date(1903,1,1);
		vehicle_life: 					30;
		model_life:						36;
		length:							7;
		
		weight: 						23 ton;
		speed:							40 mph;
		power:							300 hp;
		tractive_effort_coefficient: 	0.1220053;
		cost_factor: 					0x06 nfo;
		running_cost_factor: 			0x09 nfo;
		
		badges: ["flag/GB", "power/fourth_rail", "role/passenger"];
		
		variant_group: 			        ITEM_FAI_MU_1903_STOCK;
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					38;
		loading_speed:					3;
		
	}
	graphics {
		default:						sw_1903_STOCK_RCC_gfx_last;
		sound_effect:					sw_sfx_ELE;
		purchase:						spriteset_1903_STOCK_RCC_purchase;
		create_effect:					vfx_3rd;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						spriteset_1903_STOCK_RCC_wagon;
		length:							7;
		cargo_capacity:					40;
		loading_speed:					3;
		speed:							40 ;
	}
}
