//Sprite References & Switches
spriteset(spriteset_AM10_0_purchase, "gfx/MU/AM10.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_AM10_0, "gfx/MU/AM10.png") { template_fai_33(0, 16)}

spriteset(spriteset_AM10_0_wagon, "gfx/MU/AM10.png") { template_fai_33(0, 41)}

spriteset(spriteset_AM10_0_power, "gfx/MU/AM10.png") { template_fai_33(0, 41)}
switch(FEAT_TRAINS, SELF, sw_AM10_0_powerposition, position_in_vehid_chain - position_in_vehid_chain_from_end) {
 0..1: spriteset_AM10_0_power;
  spriteset_AM10_0_wagon;
}

switch(FEAT_TRAINS, SELF, sw_AM10_0_rearcheck, position_in_vehid_chain_from_end) {
  0: spriteset_AM10_0_power;
  spriteset_AM10_0_wagon;
}

switch(FEAT_TRAINS, SELF, sw_AM10_0_lencheck, num_vehs_in_vehid_chain){
    1..2 : sw_AM10_0_rearcheck;
    return sw_AM10_0_powerposition;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_AM10_0, 6397) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x11 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		dual_headed:					1;
		
		track_type:						ELNG;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_AM10_0); 
		introduction_date:				date(1965,1,1);
		vehicle_life: 					23;
		model_life:						37;
		length:							8;
		
		weight: 						46 ton;
		speed:							75 mph;
		power:							1080 hp;
		tractive_effort_coefficient: 	0.1441881;
		cost_factor: 					0x17 nfo;
		running_cost_factor: 			0x19 nfo;
		
		badges: ["flag/GB", "power/electric", "role/passenger"];
		
		variant_group: 			        ITEM_FAI_MU_AM10;
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					52;
		loading_speed:					3;
		
	}
	graphics {
		default:						spriteset_AM10_0;
		sound_effect:					sw_sfx_ELECTRIC;
		purchase:						spriteset_AM10_0_purchase;
		create_effect:					vfx_ohle;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						sw_AM10_0_lencheck;
		length:							8;
		cargo_capacity:					56;
		loading_speed:					3;
		speed:							75 ;
	}
}
