//Sprite References & Switches
spriteset(spriteset_HITACHI_A_TRAIN_purchase, "gfx/MU/HITACHI_A_TRAIN.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_HITACHI_A_TRAIN, "gfx/MU/HITACHI_A_TRAIN.png") { template_fai_33(0, 16)}

spriteset(spriteset_HITACHI_A_TRAIN_wagon, "gfx/MU/HITACHI_A_TRAIN.png") { template_fai_33(0, 41)}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_HITACHI_A_TRAIN, 6927) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x08 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		dual_headed:					1;
		
		track_type:						NBAZ;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_HITACHI_A_TRAIN); 
		introduction_date:				date(2016,1,1);
		vehicle_life: 					25;
		model_life:						0;
		length:							8;
		
		weight: 						49 ton;
		speed:							155 mph;
		power:							6500 hp;
		tractive_effort_coefficient: 	0.2384423;
		cost_factor: 					0x96 nfo;
		running_cost_factor: 			0xAA nfo;
		
		badges: ["flag/GB", "power/dual_voltage", "role/express_passenger"];
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					52;
		loading_speed:					4;
		
	}
	graphics {
		default:						spriteset_HITACHI_A_TRAIN;
		sound_effect:					sw_sfx_ELF;
		purchase:						spriteset_HITACHI_A_TRAIN_purchase;
		create_effect:					vfx_dual_voltage;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						spriteset_HITACHI_A_TRAIN_wagon;
		length:							8;
		cargo_capacity:					60;
		loading_speed:					4;
		speed:							155 ;
	}
}
