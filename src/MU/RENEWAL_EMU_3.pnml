//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_RENEWAL_EMU_3, 6301) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0E nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		dual_headed:					1;
		
		track_type:						NBA3;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_RENEWAL_EMU_3); 
		introduction_date:				date(1964,1,1);
		vehicle_life: 					25;
		model_life:						46;
		length:							8;
		
		weight: 						36 ton;
		speed:							90 mph;
		power:							1000 hp;
		tractive_effort_coefficient: 	0.1913265;
		cost_factor: 					0x15 nfo;
		running_cost_factor: 			0x1B nfo;
		
		badges: ["flag/GB", "power/third_rail", "role/passenger"];
		
		variant_group: 			        ITEM_FAI_MU_RENEWAL_EMU;
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					52;
		loading_speed:					3;
		
	}
	graphics {
		default:						spriteset_RENEWAL_EMU_3;
		sound_effect:					sw_sfx_ELECTRIC;
		purchase:						spriteset_RENEWAL_EMU_3_purchase;
		create_effect:					vfx_3rd;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						spriteset_RENEWAL_EMU_3_wagon;
		length:							8;
		cargo_capacity:					56;
		loading_speed:					3;
		speed:							90 ;
	}
}
