//Sprite References & Switches
spriteset(spriteset_BREL_APT_purchase, "gfx/MU/BREL_APT.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_BREL_APT, "gfx/MU/BREL_APT.png") { template_fai_33(0, 16)}

spriteset(spriteset_BREL_APT_wagon, "gfx/MU/BREL_APT.png") { template_fai_33(0, 41)}

spriteset(spriteset_BREL_APT_power, "gfx/MU/BREL_APT.png") { template_fai_33(0, 41)}
switch(FEAT_TRAINS, SELF, sw_BREL_APT_powerposition, position_in_vehid_chain - position_in_vehid_chain_from_end) {
 0..1: spriteset_BREL_APT_power;
  spriteset_BREL_APT_wagon;
}

switch(FEAT_TRAINS, SELF, sw_BREL_APT_rearcheck, position_in_vehid_chain_from_end) {
  0: spriteset_BREL_APT_power;
  spriteset_BREL_APT_wagon;
}

switch(FEAT_TRAINS, SELF, sw_BREL_APT_lencheck, num_vehs_in_vehid_chain){
    1..2 : sw_BREL_APT_rearcheck;
    return sw_BREL_APT_powerposition;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_BREL_APT, 6783) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x09 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		dual_headed:					1;
		
		track_type:						ELNG;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_BREL_APT); 
		introduction_date:				date(1977,1,1);
		vehicle_life: 					26;
		model_life:						20;
		length:							8;
		
		weight: 						70 ton;
		speed:							140 mph;
		power:							8000 hp;
		tractive_effort_coefficient: 	0.2776968;
		cost_factor: 					0x70 nfo;
		running_cost_factor: 			0x55 nfo;
		
		badges: ["flag/GB", "power/electric", "role/express_passenger"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_BREL_APT;
		sound_effect:					sw_sfx_ELECTRIC;
		purchase:						spriteset_BREL_APT_purchase;
		create_effect:					vfx_ohle;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						sw_BREL_APT_lencheck;
		length:							8;
		cargo_capacity:					54;
		loading_speed:					5;
		speed:							140 ;
	}
}
