//Sprite References & Switches
spriteset(spriteset_BREL_APT_BRB_purchase, "gfx/32bpp.png") { template_fai_purchase_mu(0, 0)}
alternative_sprites(spriteset_BREL_APT_BRB_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/BREL_APT_BRB.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_BREL_APT_BRB, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_BREL_APT_BRB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/BREL_APT_BRB.png") { template_fai_33(0, 16)}

spriteset(spriteset_BREL_APT_BRB_wagon, "gfx/32bpp.png") { template_fai_33(0, 41)}
alternative_sprites(spriteset_BREL_APT_BRB_wagon, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/BREL_APT_BRB.png") { template_fai_33(0, 41)}

spriteset(spriteset_BREL_APT_BRB_power, "gfx/32bpp.png") { template_fai_33(0, 41)}
alternative_sprites(spriteset_BREL_APT_BRB_power, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/MU/BREL_APT_BRB.png") { template_fai_33(0, 41)}
switch(FEAT_TRAINS, SELF, sw_BREL_APT_BRB_powerposition, position_in_vehid_chain - position_in_vehid_chain_from_end) {
 0..1: spriteset_BREL_APT_BRB_power;
  spriteset_BREL_APT_BRB_wagon;
}

switch(FEAT_TRAINS, SELF, sw_BREL_APT_BRB_rearcheck, position_in_vehid_chain_from_end) {
  0: spriteset_BREL_APT_BRB_power;
  spriteset_BREL_APT_BRB_wagon;
}

switch(FEAT_TRAINS, SELF, sw_BREL_APT_BRB_lencheck, num_vehs_in_vehid_chain){
    1..2 : sw_BREL_APT_BRB_rearcheck;
    return sw_BREL_APT_BRB_powerposition;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_BREL_APT_BRB, 6787) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x09 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		dual_headed:					1;
		
		track_type:						ELNG;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_BREL_APT_BRB); 
		introduction_date:				date(1977,1,1);
		vehicle_life: 					26;
		model_life:						20;
		length:							8;
		
		weight: 						70 ton;
		speed:							140 mph;
		power:							8000 hp;
		tractive_effort_coefficient: 	0.2776968;
		cost_factor: 					0x70 nfo;
		running_cost_factor: 			0x55 nfo;
		
		badges: ["flag/GB", "power/electric", "role/express_passenger"];
		
		variant_group: 			        ITEM_FAI_MU_BREL_APT;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_BREL_APT_BRB;
		sound_effect:					sw_sfx_ELECTRIC;
		purchase:						spriteset_BREL_APT_BRB_purchase;
		create_effect:					vfx_ohle;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						sw_BREL_APT_BRB_lencheck;
		length:							8;
		cargo_capacity:					54;
		loading_speed:					5;
		speed:							140 ;
	}
}
