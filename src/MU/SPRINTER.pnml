//Sprite References & Switches
spriteset(spriteset_SPRINTER_purchase, "gfx/MU/SPRINTER.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_SPRINTER, "gfx/MU/SPRINTER.png") { template_fai_33(0, 16)}

spriteset(spriteset_SPRINTER_wagon, "gfx/MU/SPRINTER.png") { template_fai_33(0, 41)}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_SPRINTER, 5651) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				NO_CLIMATE;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x11 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		dual_headed:					1;
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_DIESEL;
		engine_class: 					ENGINE_CLASS_DIESEL;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_SPRINTER); 
		introduction_date:				date(1984,1,1);
		vehicle_life: 					20;
		model_life:						0;
		length:							8;
		
		weight: 						36 ton;
		speed:							75 mph;
		power:							775 hp;
		tractive_effort_coefficient: 	0.1289683;
		cost_factor: 					0x15 nfo;
		running_cost_factor: 			0x15 nfo;
		
		badges: ["flag/GB", "power/diesel", "role/passenger"];
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					52;
		loading_speed:					2;
		
	}
	graphics {
		default:						spriteset_SPRINTER;
		sound_effect:					sw_sfx_66;
		purchase:						spriteset_SPRINTER_purchase;
		create_effect:					vfx_DIESEL;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						spriteset_SPRINTER_wagon;
		length:							8;
		cargo_capacity:					56;
		loading_speed:					2;
		speed:							75 ;
	}
}
