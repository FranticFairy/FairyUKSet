//Sprite References & Switches
spriteset(spriteset_CLASS_321_purchase, "gfx/MU/CLASS_321.png") { template_fai_purchase_mu(0, 0)}

spriteset(spriteset_CLASS_321, "gfx/MU/CLASS_321.png") { template_fai_33(0, 16)}

spriteset(spriteset_CLASS_321_wagon, "gfx/MU/CLASS_321.png") { template_fai_33(0, 41)}

spriteset(spriteset_CLASS_321_power, "gfx/MU/CLASS_321.png") { template_fai_33(0, 41)}
switch(FEAT_TRAINS, SELF, sw_CLASS_321_powerposition, position_in_vehid_chain - position_in_vehid_chain_from_end) {
 0..1: spriteset_CLASS_321_power;
  spriteset_CLASS_321_wagon;
}

switch(FEAT_TRAINS, SELF, sw_CLASS_321_rearcheck, position_in_vehid_chain_from_end) {
  0: spriteset_CLASS_321_power;
  spriteset_CLASS_321_wagon;
}

switch(FEAT_TRAINS, SELF, sw_CLASS_321_lencheck, num_vehs_in_vehid_chain){
    1..2 : sw_CLASS_321_rearcheck;
    return sw_CLASS_321_powerposition;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_MU_CLASS_321, 6588) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				NO_CLIMATE;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0D nfo;
		misc_flags:						bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		dual_headed:					1;
		
		track_type:						ELNG;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_CLASS_321); 
		introduction_date:				date(1988,1,1);
		vehicle_life: 					23;
		model_life:						0;
		length:							8;
		
		weight: 						41 ton;
		speed:							100 mph;
		power:							1400 hp;
		tractive_effort_coefficient: 	0.1841712;
		cost_factor: 					0x19 nfo;
		running_cost_factor: 			0x23 nfo;
		
		badges: ["flag/GB", "power/electric", "role/passenger"];
		
		refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					56;
		loading_speed:					2;
		
	}
	graphics {
		default:						spriteset_CLASS_321;
		sound_effect:					sw_sfx_ELF;
		purchase:						spriteset_CLASS_321_purchase;
		create_effect:					vfx_ohle;
	}
	livery_override (ITEM_FAI_WAGON_MU_COACH) {
		default:						sw_CLASS_321_lencheck;
		length:							8;
		cargo_capacity:					60;
		loading_speed:					2;
		speed:							100 ;
	}
}
