//Sprite References & Switches
spriteset(spriteset_SCRAP_WAGON_purchase, "gfx/CW/SCRAP_WAGON.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_SCRAP_WAGON, "gfx/CW/SCRAP_WAGON.png") { template_fai_21(0, 16)}
spriteset(spriteset_SCRAP_WAGON_R, "gfx/CW/SCRAP_WAGON.png") { template_fai_21(0, 41)}

spriteset(spriteset_SCRAP_WAGON_SCMT_H, "gfx/CW/SCRAP_WAGON_SCMT.png") { template_fai_21(0, 41)}
spriteset(spriteset_SCRAP_WAGON_SCMT_F, "gfx/CW/SCRAP_WAGON_SCMT.png") { template_fai_21(0, 66)}

spriteset(spriteset_SCRAP_WAGON_COAL_H, "gfx/CW/SCRAP_WAGON_COAL.png") { template_fai_21(0, 41)}
spriteset(spriteset_SCRAP_WAGON_COAL_F, "gfx/CW/SCRAP_WAGON_COAL.png") { template_fai_21(0, 66)}

switch(FEAT_TRAINS, SELF, sw_SCRAP_WAGON_loadcheck_SCMT, PERCENT_FULL){
	1..50	: spriteset_SCRAP_WAGON_SCMT_H ;
	51..100	: spriteset_SCRAP_WAGON_SCMT_F ;
}
switch(FEAT_TRAINS, SELF, sw_SCRAP_WAGON_loadcheck_COAL, PERCENT_FULL){
	1..50	: spriteset_SCRAP_WAGON_COAL_H ;
	51..100	: spriteset_SCRAP_WAGON_COAL_F ;
}

random_switch (FEAT_TRAINS, SELF, sw_SCRAP_WAGON_randomtexture, TRIGGER_VEHICLE_ANY_LOAD) {
	1: spriteset_SCRAP_WAGON;
	1: spriteset_SCRAP_WAGON_R;
}

switch (FEAT_TRAINS, SELF, sw_SCRAP_WAGON_getwagon, STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)) {
    return sw_SCRAP_WAGON_randomtexture;
}

switch (FEAT_TRAINS, SELF, sw_SCRAP_WAGON_recolour_load, STORE_TEMP(switch_generic_recolour(), 0x100)) {
    return sw_SCRAP_WAGON_loadcheck_COAL;
}

switch(FEAT_TRAINS, SELF, sw_SCRAP_WAGON_cargocheck, cargo_type_in_veh){
	SCMT : sw_SCRAP_WAGON_loadcheck_SCMT ;
	sw_SCRAP_WAGON_recolour_load ;
}

switch (FEAT_TRAINS, SELF, sw_SCRAP_WAGON_compose, getbits(extra_callback_info1, 8, 8)) {
    0: return sw_SCRAP_WAGON_getwagon;
    return sw_SCRAP_WAGON_cargocheck;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_CW_SCRAP_WAGON, 23421) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_SCRAP_WAGON); 
		introduction_date:				date(1978,1,1);
		model_life:						VEHICLE_NEVER_EXPIRES;
		length:							5;
		
		weight: 						15 ton;
		speed:							60 mph;
		cost_factor: 					0x28 nfo;
		running_cost_factor: 			0x0D nfo;
		
		refittable_cargo_classes:		bitmask(CC_BULK);
		non_refittable_cargo_classes:		bitmask(CC_PASSENGERS,CC_COVERED);
		default_cargo_type:				SCMT;
        loading_speed:                  4;
		cargo_capacity:					20;
		
	}
	graphics {
		default:						sw_SCRAP_WAGON_compose;
		purchase:						spriteset_SCRAP_WAGON_purchase;
	}
}
