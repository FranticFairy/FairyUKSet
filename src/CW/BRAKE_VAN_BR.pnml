//Sprite References & Switches
spriteset(spriteset_BRAKE_VAN_BR_purchase, "gfx/CW/BRAKE_VAN_BR.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_BRAKE_VAN_BR, "gfx/CW/BRAKE_VAN_BR.png") { template_fai_21(0, 16)}
spriteset(spriteset_BRAKE_VAN_BR_2, "gfx/CW/BRAKE_VAN_BR_CC2.png") { template_fai_21(0, 16)}
spriteset(spriteset_BRAKE_VAN_BR_B, "gfx/CW/BRAKE_VAN_BR_BROWN.png") { template_fai_21(0, 16)}

random_switch (FEAT_TRAINS, SELF, sw_spriteset_BRAKE_VAN_BR_randomtexture) {
	1: spriteset_BRAKE_VAN_BR;
	1: spriteset_BRAKE_VAN_BR_B;
	1: spriteset_BRAKE_VAN_BR_2;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_CW_BRAKE_VAN_BR, 20121) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_BRAKE_VAN_BR); 
		introduction_date:				date(1948,1,1);
		model_life:						40;
		length:							5;
		
		weight: 						20 ton;
		speed:							70 mph;
		cost_factor: 					0x1E nfo;
		running_cost_factor: 			0x12 nfo;
		default_cargo_type:				GOOD;
		cargo_capacity:					0;
		
	}
	graphics {
		default:						sw_spriteset_BRAKE_VAN_BR_randomtexture;
		purchase:						spriteset_BRAKE_VAN_BR_purchase;
	}
}
