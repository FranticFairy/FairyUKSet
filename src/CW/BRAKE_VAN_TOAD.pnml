//Sprite References & Switches
spriteset(spriteset_BRAKE_VAN_TOAD_purchase, "gfx/CW/BRAKE_VAN_TOAD.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_BRAKE_VAN_TOAD, "gfx/CW/BRAKE_VAN_TOAD.png") { template_fai_21(0, 16)}
spriteset(spriteset_BRAKE_VAN_TOAD_2, "gfx/CW/BRAKE_VAN_TOAD_CC2.png") { template_fai_21(0, 16)}
spriteset(spriteset_BRAKE_VAN_TOAD_B, "gfx/CW/BRAKE_VAN_TOAD_BROWN.png") { template_fai_21(0, 16)}

random_switch (FEAT_TRAINS, SELF, sw_spriteset_BRAKE_VAN_TOAD_randomtexture) {
	1: spriteset_BRAKE_VAN_TOAD;
	1: spriteset_BRAKE_VAN_TOAD_B;
	1: spriteset_BRAKE_VAN_TOAD_2;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_CW_BRAKE_VAN_TOAD, 20181) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_BRAKE_VAN_TOAD); 
		introduction_date:				date(1894,1,1);
		model_life:						74;
		length:							5;
		
		weight: 						20 ton;
		speed:							65 mph;
		cost_factor: 					0x20 nfo;
		running_cost_factor: 			0x14 nfo;
		default_cargo_type:				GOOD;
		cargo_capacity:					0;
		
	}
	graphics {
		default:						sw_spriteset_BRAKE_VAN_TOAD_randomtexture;
		purchase:						spriteset_BRAKE_VAN_TOAD_purchase;
	}
}
