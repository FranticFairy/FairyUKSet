//Sprite References & Switches
spriteset(spriteset_BRAKE_PULLMAN_MAROON_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_BRAKE_PULLMAN_MAROON_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BRAKE_PULLMAN_MAROON.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_BRAKE_PULLMAN_MAROON, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_BRAKE_PULLMAN_MAROON, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BRAKE_PULLMAN_MAROON.png") { template_fai_33(0, 16)}
spriteset(spriteset_BRAKE_PULLMAN_MAROON_F, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_BRAKE_PULLMAN_MAROON_F, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BRAKE_PULLMAN_MAROON.png") { template_fai_33(0, 41)}
spriteset(spriteset_BRAKE_PULLMAN_MAROON_E, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_BRAKE_PULLMAN_MAROON_E, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BRAKE_PULLMAN_MAROON.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_BRAKE_PULLMAN_MAROON_S, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_BRAKE_PULLMAN_MAROON_S, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BRAKE_PULLMAN_MAROON.png") { template_fai_33(0, 16)}

switch(FEAT_TRAINS, SELF, sw_BRAKE_PULLMAN_MAROON_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_BRAKE_PULLMAN_MAROON; //All Gangways
	return spriteset_BRAKE_PULLMAN_MAROON_F;
}
switch(FEAT_TRAINS, SELF, sw_BRAKE_PULLMAN_MAROON_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_BRAKE_PULLMAN_MAROON_E; //All Gangways
	return spriteset_BRAKE_PULLMAN_MAROON_S;
}

switch(FEAT_TRAINS, SELF, sw_BRAKE_PULLMAN_MAROON_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_BRAKE_PULLMAN_MAROON_leftcheck; //All Gangways
	return sw_BRAKE_PULLMAN_MAROON_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_BRAKE_PULLMAN_MAROON, 8125) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_BRAKE_PULLMAN_MAROON); 
		introduction_date:				date(1928,1,1);
		model_life:						42;
		length:							8;
		
		weight: 						33 ton;
		speed:							100 mph;
		cost_factor: 					0x7B nfo;
		running_cost_factor: 			0x28 nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		variant_group: 			        ITEM_FAI_PW_BRAKE_PULLMAN;
		
		refittable_cargo_classes:		bitmask(CC_MAIL,CC_EXPRESS,CC_ARMOURED);
		non_refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		default_cargo_type:				MAIL;
		cargo_capacity:					20;
		loading_speed:					6;
		
	}
	graphics {
		default:						sw_BRAKE_PULLMAN_MAROON_rightcheck;
		purchase:						spriteset_BRAKE_PULLMAN_MAROON_purchase;
	}
}
