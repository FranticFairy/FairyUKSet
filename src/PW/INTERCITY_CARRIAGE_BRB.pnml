//Sprite References & Switches
spriteset(spriteset_INTERCITY_CARRIAGE_BRB_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_INTERCITY_CARRIAGE_BRB_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/INTERCITY_CARRIAGE_BRB.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_INTERCITY_CARRIAGE_BRB, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_INTERCITY_CARRIAGE_BRB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/INTERCITY_CARRIAGE_BRB.png") { template_fai_33(0, 16)}
spriteset(spriteset_INTERCITY_CARRIAGE_BRB_F, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_INTERCITY_CARRIAGE_BRB_F, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/INTERCITY_CARRIAGE_BRB.png") { template_fai_33(0, 41)}
spriteset(spriteset_INTERCITY_CARRIAGE_BRB_E, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_INTERCITY_CARRIAGE_BRB_E, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/INTERCITY_CARRIAGE_BRB.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_INTERCITY_CARRIAGE_BRB_S, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_INTERCITY_CARRIAGE_BRB_S, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/INTERCITY_CARRIAGE_BRB.png") { template_fai_33(0, 16)}

switch(FEAT_TRAINS, SELF, sw_INTERCITY_CARRIAGE_BRB_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_INTERCITY_CARRIAGE_BRB; //All Gangways
	return spriteset_INTERCITY_CARRIAGE_BRB_F;
}
switch(FEAT_TRAINS, SELF, sw_INTERCITY_CARRIAGE_BRB_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_INTERCITY_CARRIAGE_BRB_E; //All Gangways
	return spriteset_INTERCITY_CARRIAGE_BRB_S;
}

switch(FEAT_TRAINS, SELF, sw_INTERCITY_CARRIAGE_BRB_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_INTERCITY_CARRIAGE_BRB_leftcheck; //All Gangways
	return sw_INTERCITY_CARRIAGE_BRB_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_INTERCITY_CARRIAGE_BRB, 8412) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_INTERCITY_CARRIAGE_BRB); 
		introduction_date:				date(1985,1,1);
		model_life:						35;
		length:							8;
		
		weight: 						38 ton;
		speed:							140 mph;
		cost_factor: 					0xA8 nfo;
		running_cost_factor: 			0x4F nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		variant_group: 			        ITEM_FAI_PW_INTERCITY_CARRIAGE;
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					56;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_INTERCITY_CARRIAGE_BRB_rightcheck;
		purchase:						spriteset_INTERCITY_CARRIAGE_BRB_purchase;
	}
}
