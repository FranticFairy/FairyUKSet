//Sprite References & Switches
spriteset(spriteset_PASSENGER_CARRIAGE_NBR_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_PASSENGER_CARRIAGE_NBR_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/PASSENGER_CARRIAGE_NBR.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_PASSENGER_CARRIAGE_NBR, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_PASSENGER_CARRIAGE_NBR, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/PASSENGER_CARRIAGE_NBR.png") { template_fai_33(0, 16)}
spriteset(spriteset_PASSENGER_CARRIAGE_NBR_F, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_PASSENGER_CARRIAGE_NBR_F, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/PASSENGER_CARRIAGE_NBR.png") { template_fai_33(0, 41)}
spriteset(spriteset_PASSENGER_CARRIAGE_NBR_E, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_PASSENGER_CARRIAGE_NBR_E, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/PASSENGER_CARRIAGE_NBR.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_PASSENGER_CARRIAGE_NBR_S, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_PASSENGER_CARRIAGE_NBR_S, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/PASSENGER_CARRIAGE_NBR.png") { template_fai_33(0, 16)}

switch(FEAT_TRAINS, SELF, sw_PASSENGER_CARRIAGE_NBR_leftcheck, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]){
	7768..8770: spriteset_PASSENGER_CARRIAGE_NBR; //All Gangways
	return spriteset_PASSENGER_CARRIAGE_NBR_F;
}
switch(FEAT_TRAINS, SELF, sw_PASSENGER_CARRIAGE_NBR_leftcheck_noright, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]){
	7768..8770: spriteset_PASSENGER_CARRIAGE_NBR_E; //All Gangways
	return spriteset_PASSENGER_CARRIAGE_NBR_S;
}

switch(FEAT_TRAINS, SELF, sw_PASSENGER_CARRIAGE_NBR_rightcheck, [STORE_TEMP(1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]){
	7768..8770: sw_PASSENGER_CARRIAGE_NBR_leftcheck; //All Gangways
	return sw_PASSENGER_CARRIAGE_NBR_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_PASSENGER_CARRIAGE_NBR, 8021) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_PASSENGER_CARRIAGE_NBR); 
		introduction_date:				date(1912,1,1);
		model_life:						45;
		length:							8;
		
		weight: 						33 ton;
		speed:							100 mph;
		cost_factor: 					0x91 nfo;
		running_cost_factor: 			0x4E nfo;
		
		variant_group: 			        ITEM_FAI_PW_PASSENGER_CARRIAGE;
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					42;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_PASSENGER_CARRIAGE_NBR_rightcheck;
		purchase:						spriteset_PASSENGER_CARRIAGE_NBR_purchase;
	}
}
