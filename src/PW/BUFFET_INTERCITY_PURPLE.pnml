//Sprite References & Switches
spriteset(spriteset_BUFFET_INTERCITY_PURPLE_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_BUFFET_INTERCITY_PURPLE_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BUFFET_INTERCITY_PURPLE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_BUFFET_INTERCITY_PURPLE, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_BUFFET_INTERCITY_PURPLE, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BUFFET_INTERCITY_PURPLE.png") { template_fai_33(0, 16)}
spriteset(spriteset_BUFFET_INTERCITY_PURPLE_F, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_BUFFET_INTERCITY_PURPLE_F, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BUFFET_INTERCITY_PURPLE.png") { template_fai_33(0, 41)}
spriteset(spriteset_BUFFET_INTERCITY_PURPLE_E, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_BUFFET_INTERCITY_PURPLE_E, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BUFFET_INTERCITY_PURPLE.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_BUFFET_INTERCITY_PURPLE_S, "gfx/32bpp.png") { template_fai_33(0, 16)}
alternative_sprites(spriteset_BUFFET_INTERCITY_PURPLE_S, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/BUFFET_INTERCITY_PURPLE.png") { template_fai_33(0, 16)}

switch(FEAT_TRAINS, SELF, sw_BUFFET_INTERCITY_PURPLE_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_BUFFET_INTERCITY_PURPLE; //All Gangways
	return spriteset_BUFFET_INTERCITY_PURPLE_F;
}
switch(FEAT_TRAINS, SELF, sw_BUFFET_INTERCITY_PURPLE_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_BUFFET_INTERCITY_PURPLE_E; //All Gangways
	return spriteset_BUFFET_INTERCITY_PURPLE_S;
}

switch(FEAT_TRAINS, SELF, sw_BUFFET_INTERCITY_PURPLE_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_BUFFET_INTERCITY_PURPLE_leftcheck; //All Gangways
	return sw_BUFFET_INTERCITY_PURPLE_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_BUFFET_INTERCITY_PURPLE, 8437) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_BUFFET_INTERCITY_PURPLE); 
		introduction_date:				date(1985,1,1);
		model_life:						0;
		length:							8;
		
		weight: 						40 ton;
		speed:							140 mph;
		cost_factor: 					0xAA nfo;
		running_cost_factor: 			0x52 nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		variant_group: 			        ITEM_FAI_PW_BUFFET_INTERCITY;
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					20;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_BUFFET_INTERCITY_PURPLE_rightcheck;
		purchase:						spriteset_BUFFET_INTERCITY_PURPLE_purchase;
	}
}
