//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_6_WHEEL_COACH, 7293) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_6_WHEEL_COACH); 
		introduction_date:				date(1850,1,1);
		model_life:						70;
		length:							5;
		
		weight: 						21 ton;
		speed:							60 mph;
		cost_factor: 					0x5D nfo;
		running_cost_factor: 			0x2D nfo;
		
		badges: ["flag/GB"];
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					24;
		loading_speed:					4;
		
	}
	graphics {
		default:						spriteset_6_WHEEL_COACH;
		purchase:						spriteset_6_WHEEL_COACH_purchase;
	}
}
