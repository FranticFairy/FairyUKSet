//Sprite References & Switches
spriteset(spriteset_ARTICULATED_CARRIAGES_purchase, "gfx/PW/ARTICULATED_CARRIAGES.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_ARTICULATED_CARRIAGES, "gfx/PW/ARTICULATED_CARRIAGES.png") { template_fai_29(0, 16)}
spriteset(spriteset_ARTICULATED_CARRIAGES_F, "gfx/PW/ARTICULATED_CARRIAGES.png") { template_fai_29(0, 41)}
spriteset(spriteset_ARTICULATED_CARRIAGES_E, "gfx/PW/ARTICULATED_CARRIAGES.png") { template_fai_29_r(0, 41)}
spriteset(spriteset_ARTICULATED_CARRIAGES_S, "gfx/PW/ARTICULATED_CARRIAGES.png") { template_fai_29(0, 16)}
spriteset(spriteset_ARTICULATED_CARRIAGES_S1, "gfx/PW/ARTICULATED_CARRIAGES.png") { template_fai_29(0, 41)}
switch(FEAT_TRAINS, SELF, sw_ARTICULATED_CARRIAGES_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_ARTICULATED_CARRIAGES; //All Gangways
	return spriteset_ARTICULATED_CARRIAGES_F;
}
switch(FEAT_TRAINS, SELF, sw_ARTICULATED_CARRIAGES_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_ARTICULATED_CARRIAGES_E; //All Gangways
	return spriteset_ARTICULATED_CARRIAGES_S;
}

switch(FEAT_TRAINS, SELF, sw_ARTICULATED_CARRIAGES_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_ARTICULATED_CARRIAGES_leftcheck; //All Gangways
	return sw_ARTICULATED_CARRIAGES_leftcheck_noright;
}

switch(FEAT_TRAINS, SELF, sw_articulated_PW_ARTICULATED_CARRIAGES, position_in_articulated_veh) {
	0: sw_ARTICULATED_CARRIAGES_leftcheck;
	1: sw_ARTICULATED_CARRIAGES_rightcheck;
	spriteset_ARTICULATED_CARRIAGES;
}

switch(FEAT_TRAINS, SELF, sw_articulation_PW_ARTICULATED_CARRIAGES, extra_callback_info1) {
	1: return ITEM_FAI_PW_ARTICULATED_CARRIAGES;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_ARTICULATED_CARRIAGES, 7768) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				NO_CLIMATE;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_ARTICULATED_CARRIAGES); 
		introduction_date:				date(1925,1,1);
		model_life:						30;
		length:							7;
		
		weight: 						50 ton;
		speed:							120 mph;
		cost_factor: 					0xFD nfo;
		running_cost_factor: 			0x84 nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					36;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_articulated_PW_ARTICULATED_CARRIAGES;
        articulated_part:               sw_articulation_PW_ARTICULATED_CARRIAGES;
		purchase:						spriteset_ARTICULATED_CARRIAGES_purchase;
	}
}
