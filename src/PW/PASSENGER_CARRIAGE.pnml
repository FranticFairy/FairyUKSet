//Sprite References & Switches
spriteset(spriteset_PASSENGER_CARRIAGE_purchase, "gfx/PW/PASSENGER_CARRIAGE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_PASSENGER_CARRIAGE, "gfx/PW/PASSENGER_CARRIAGE.png") { template_fai_33(0, 16)}
spriteset(spriteset_PASSENGER_CARRIAGE_F, "gfx/PW/PASSENGER_CARRIAGE.png") { template_fai_33(0, 41)}
spriteset(spriteset_PASSENGER_CARRIAGE_E, "gfx/PW/PASSENGER_CARRIAGE.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_PASSENGER_CARRIAGE_S, "gfx/PW/PASSENGER_CARRIAGE.png") { template_fai_33(0, 16)}
switch(FEAT_TRAINS, SELF, sw_PASSENGER_CARRIAGE_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_PASSENGER_CARRIAGE; //All Gangways
	return spriteset_PASSENGER_CARRIAGE_F;
}
switch(FEAT_TRAINS, SELF, sw_PASSENGER_CARRIAGE_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_PASSENGER_CARRIAGE_E; //All Gangways
	return spriteset_PASSENGER_CARRIAGE_S;
}

switch(FEAT_TRAINS, SELF, sw_PASSENGER_CARRIAGE_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_PASSENGER_CARRIAGE_leftcheck; //All Gangways
	return sw_PASSENGER_CARRIAGE_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_PASSENGER_CARRIAGE, 7916) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				NO_CLIMATE;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_PASSENGER_CARRIAGE); 
		introduction_date:				date(1912,1,1);
		model_life:						45;
		length:							8;
		
		weight: 						33 ton;
		speed:							100 mph;
		cost_factor: 					0x91 nfo;
		running_cost_factor: 			0x4E nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					42;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_PASSENGER_CARRIAGE_rightcheck;
		purchase:						spriteset_PASSENGER_CARRIAGE_purchase;
	}
}
