//Sprite References & Switches
spriteset(spriteset_PULLMAN_purchase, "gfx/PW/PULLMAN.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_PULLMAN, "gfx/PW/PULLMAN.png") { template_fai_33(0, 16)}
spriteset(spriteset_PULLMAN_F, "gfx/PW/PULLMAN.png") { template_fai_33(0, 41)}
spriteset(spriteset_PULLMAN_E, "gfx/PW/PULLMAN.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_PULLMAN_S, "gfx/PW/PULLMAN.png") { template_fai_33(0, 16)}
switch(FEAT_TRAINS, SELF, sw_PULLMAN_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_PULLMAN; //All Gangways
	return spriteset_PULLMAN_F;
}
switch(FEAT_TRAINS, SELF, sw_PULLMAN_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_PULLMAN_E; //All Gangways
	return spriteset_PULLMAN_S;
}

switch(FEAT_TRAINS, SELF, sw_PULLMAN_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_PULLMAN_leftcheck; //All Gangways
	return sw_PULLMAN_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_PULLMAN, 8041) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_PULLMAN); 
		introduction_date:				date(1928,1,1);
		model_life:						42;
		length:							8;
		
		weight: 						35 ton;
		speed:							100 mph;
		cost_factor: 					0x96 nfo;
		running_cost_factor: 			0x51 nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					28;
		loading_speed:					6;
		
	}
	graphics {
		default:						sw_PULLMAN_rightcheck;
		purchase:						spriteset_PULLMAN_purchase;
	}
}
