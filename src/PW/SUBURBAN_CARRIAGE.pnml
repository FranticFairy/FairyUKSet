//Sprite References & Switches
spriteset(spriteset_SUBURBAN_CARRIAGE_purchase, "gfx/PW/SUBURBAN_CARRIAGE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_SUBURBAN_CARRIAGE, "gfx/PW/SUBURBAN_CARRIAGE.png") { template_fai_29(0, 16)}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_SUBURBAN_CARRIAGE, 7693) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				NO_CLIMATE;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_SUBURBAN_CARRIAGE); 
		introduction_date:				date(1912,1,1);
		model_life:						45;
		length:							7;
		
		weight: 						25 ton;
		speed:							90 mph;
		cost_factor: 					0x80 nfo;
		running_cost_factor: 			0x46 nfo;
		
		badges: ["flag/GB"];
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					36;
		loading_speed:					5;
		
	}
	graphics {
		default:						spriteset_SUBURBAN_CARRIAGE;
		purchase:						spriteset_SUBURBAN_CARRIAGE_purchase;
	}
}
