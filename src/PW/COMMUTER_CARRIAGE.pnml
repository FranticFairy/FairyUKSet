//Sprite References & Switches
spriteset(spriteset_COMMUTER_CARRIAGE_purchase, "gfx/PW/COMMUTER_CARRIAGE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_COMMUTER_CARRIAGE, "gfx/PW/COMMUTER_CARRIAGE.png") { template_fai_33(0, 16)}
spriteset(spriteset_COMMUTER_CARRIAGE_F, "gfx/PW/COMMUTER_CARRIAGE.png") { template_fai_33(0, 41)}
spriteset(spriteset_COMMUTER_CARRIAGE_E, "gfx/PW/COMMUTER_CARRIAGE.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_COMMUTER_CARRIAGE_S, "gfx/PW/COMMUTER_CARRIAGE.png") { template_fai_33(0, 16)}
switch(FEAT_TRAINS, SELF, sw_COMMUTER_CARRIAGE_leftcheck, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]){
	7768..8770: spriteset_COMMUTER_CARRIAGE; //All Gangways
	return spriteset_COMMUTER_CARRIAGE_F;
}
switch(FEAT_TRAINS, SELF, sw_COMMUTER_CARRIAGE_leftcheck_noright, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]){
	7768..8770: spriteset_COMMUTER_CARRIAGE_E; //All Gangways
	return spriteset_COMMUTER_CARRIAGE_S;
}

switch(FEAT_TRAINS, SELF, sw_COMMUTER_CARRIAGE_rightcheck, [STORE_TEMP(1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]){
	7768..8770: sw_COMMUTER_CARRIAGE_leftcheck; //All Gangways
	return sw_COMMUTER_CARRIAGE_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_COMMUTER_CARRIAGE, 7966) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				NO_CLIMATE;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_COMMUTER_CARRIAGE); 
		introduction_date:				date(1985,1,1);
		model_life:						0;
		length:							8;
		
		weight: 						30 ton;
		speed:							90 mph;
		cost_factor: 					0x91 nfo;
		running_cost_factor: 			0x4E nfo;
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					48;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_COMMUTER_CARRIAGE_rightcheck;
		purchase:						spriteset_COMMUTER_CARRIAGE_purchase;
	}
}
