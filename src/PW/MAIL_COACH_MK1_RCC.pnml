//Sprite References & Switches
spriteset(spriteset_MAIL_COACH_MK1_RCC_purchase, "gfx/PW/MAIL_COACH_MK1_RCC.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_MAIL_COACH_MK1_RCC, "gfx/PW/MAIL_COACH_MK1_RCC.png") { template_fai_33(0, 16)}
spriteset(spriteset_MAIL_COACH_MK1_RCC_F, "gfx/PW/MAIL_COACH_MK1_RCC.png") { template_fai_33(0, 41)}
spriteset(spriteset_MAIL_COACH_MK1_RCC_E, "gfx/PW/MAIL_COACH_MK1_RCC.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_MAIL_COACH_MK1_RCC_S, "gfx/PW/MAIL_COACH_MK1_RCC.png") { template_fai_33(0, 16)}
switch(FEAT_TRAINS, SELF, sw_MAIL_COACH_MK1_RCC_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_MAIL_COACH_MK1_RCC; //All Gangways
	return spriteset_MAIL_COACH_MK1_RCC_F;
}
switch(FEAT_TRAINS, SELF, sw_MAIL_COACH_MK1_RCC_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_MAIL_COACH_MK1_RCC_E; //All Gangways
	return spriteset_MAIL_COACH_MK1_RCC_S;
}

switch(FEAT_TRAINS, SELF, sw_MAIL_COACH_MK1_RCC_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_MAIL_COACH_MK1_RCC_leftcheck; //All Gangways
	return sw_MAIL_COACH_MK1_RCC_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_MAIL_COACH_MK1_RCC, 8626) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_MAIL_COACH_MK1_RCC); 
		introduction_date:				date(1948,1,1);
		model_life:						60;
		length:							8;
		
		weight: 						31 ton;
		speed:							100 mph;
		cost_factor: 					0x76 nfo;
		running_cost_factor: 			0x25 nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		variant_group: 			        ITEM_FAI_PW_MAIL_COACH_MK1;
		
		refittable_cargo_classes:		bitmask(CC_MAIL,CC_EXPRESS,CC_ARMOURED);
		non_refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		default_cargo_type:				MAIL;
		cargo_capacity:					30;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_MAIL_COACH_MK1_RCC_rightcheck;
		purchase:						spriteset_MAIL_COACH_MK1_RCC_purchase;
	}
}
