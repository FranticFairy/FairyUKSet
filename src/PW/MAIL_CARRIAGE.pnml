//Sprite References & Switches
spriteset(spriteset_MAIL_CARRIAGE_purchase, "gfx/PW/MAIL_CARRIAGE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_MAIL_CARRIAGE, "gfx/PW/MAIL_CARRIAGE.png") { template_fai_29(0, 16)}
spriteset(spriteset_MAIL_CARRIAGE_F, "gfx/PW/MAIL_CARRIAGE.png") { template_fai_29(0, 41)}
spriteset(spriteset_MAIL_CARRIAGE_E, "gfx/PW/MAIL_CARRIAGE.png") { template_fai_29_r(0, 41)}
spriteset(spriteset_MAIL_CARRIAGE_S, "gfx/PW/MAIL_CARRIAGE.png") { template_fai_29(0, 16)}
switch(FEAT_TRAINS, SELF, sw_MAIL_CARRIAGE_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_MAIL_CARRIAGE; //All Gangways
	return spriteset_MAIL_CARRIAGE_F;
}
switch(FEAT_TRAINS, SELF, sw_MAIL_CARRIAGE_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_MAIL_CARRIAGE_E; //All Gangways
	return spriteset_MAIL_CARRIAGE_S;
}

switch(FEAT_TRAINS, SELF, sw_MAIL_CARRIAGE_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_MAIL_CARRIAGE_leftcheck; //All Gangways
	return sw_MAIL_CARRIAGE_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_MAIL_CARRIAGE, 8675) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_MAIL_CARRIAGE); 
		introduction_date:				date(1965,1,1);
		model_life:						0;
		length:							7;
		
		weight: 						28 ton;
		speed:							100 mph;
		cost_factor: 					0x6C nfo;
		running_cost_factor: 			0x25 nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		refittable_cargo_classes:		bitmask(CC_MAIL,CC_EXPRESS,CC_ARMOURED);
		non_refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		default_cargo_type:				MAIL;
		cargo_capacity:					30;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_MAIL_CARRIAGE_rightcheck;
		purchase:						spriteset_MAIL_CARRIAGE_purchase;
	}
}
