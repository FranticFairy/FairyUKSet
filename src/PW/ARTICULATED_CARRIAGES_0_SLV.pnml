spriteset(spriteset_ARTICULATED_CARRIAGES_0_SLV_S1, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_ARTICULATED_CARRIAGES_0_SLV_S1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/ARTICULATED_CARRIAGES_SLV.png") { template_fai_29(0, 41)}
switch(FEAT_TRAINS, SELF, sw_ARTICULATED_CARRIAGES_0_SLV_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_ARTICULATED_CARRIAGES_0_SLV; //All Gangways
	return spriteset_ARTICULATED_CARRIAGES_0_SLV_F;
}
switch(FEAT_TRAINS, SELF, sw_ARTICULATED_CARRIAGES_0_SLV_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_ARTICULATED_CARRIAGES_0_SLV_E; //All Gangways
	return spriteset_ARTICULATED_CARRIAGES_0_SLV_S;
}

switch(FEAT_TRAINS, SELF, sw_ARTICULATED_CARRIAGES_0_SLV_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_ARTICULATED_CARRIAGES_0_SLV_leftcheck; //All Gangways
	return sw_ARTICULATED_CARRIAGES_0_SLV_leftcheck_noright;
}

switch(FEAT_TRAINS, SELF, sw_articulated_PW_ARTICULATED_CARRIAGES_0_SLV, position_in_articulated_veh) {
	0: sw_ARTICULATED_CARRIAGES_0_SLV_leftcheck;
	1: sw_ARTICULATED_CARRIAGES_0_SLV_rightcheck;
	spriteset_ARTICULATED_CARRIAGES_0_SLV;
}

switch(FEAT_TRAINS, SELF, sw_articulation_PW_ARTICULATED_CARRIAGES_0_SLV, extra_callback_info1) {
	1: return ITEM_FAI_PW_ARTICULATED_CARRIAGES_0_SLV;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

