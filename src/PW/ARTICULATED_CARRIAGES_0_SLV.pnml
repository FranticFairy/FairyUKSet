spriteset(spriteset_ARTICULATED_CARRIAGES_0_SLV, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_ARTICULATED_CARRIAGES_0_SLV, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/ARTICULATED_CARRIAGES_SLV.png") { template_fai_29(0, 16)}
spriteset(spriteset_ARTICULATED_CARRIAGES_0_SLV_F, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_ARTICULATED_CARRIAGES_0_SLV_F, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/ARTICULATED_CARRIAGES_SLV.png") { template_fai_29(0, 41)}
spriteset(spriteset_ARTICULATED_CARRIAGES_0_SLV_E, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_ARTICULATED_CARRIAGES_0_SLV_E, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW/ARTICULATED_CARRIAGES_SLV.png") { template_fai_29_r(0, 41)}
