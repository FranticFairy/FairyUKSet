	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_ARTICULATED_CARRIAGES_0_SLV); 
		introduction_date:				date(1925,1,1);
		model_life:						30;
		length:							7;
		
		weight: 						50 ton;
		speed:							120 mph;
		cost_factor: 					0xFD nfo;
		running_cost_factor: 			0x84 nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		variant_group: 			        ITEM_FAI_PW_ARTICULATED_CARRIAGES_0;
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					36;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_articulated_PW_ARTICULATED_CARRIAGES_0_SLV;
        articulated_part:               sw_articulation_PW_ARTICULATED_CARRIAGES_0_SLV;
		purchase:						spriteset_ARTICULATED_CARRIAGES_0_SLV_purchase;
	}
}
