//Sprite References & Switches
spriteset(spriteset_MK4_CARRIAGE_CC1_purchase, "gfx/PW/MK4_CARRIAGE_CC1.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_MK4_CARRIAGE_CC1, "gfx/PW/MK4_CARRIAGE_CC1.png") { template_fai_33(0, 16)}
spriteset(spriteset_MK4_CARRIAGE_CC1_F, "gfx/PW/MK4_CARRIAGE_CC1.png") { template_fai_33(0, 41)}
spriteset(spriteset_MK4_CARRIAGE_CC1_E, "gfx/PW/MK4_CARRIAGE_CC1.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_MK4_CARRIAGE_CC1_S, "gfx/PW/MK4_CARRIAGE_CC1.png") { template_fai_33(0, 16)}
switch(FEAT_TRAINS, SELF, sw_MK4_CARRIAGE_CC1_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_MK4_CARRIAGE_CC1; //All Gangways
	return spriteset_MK4_CARRIAGE_CC1_F;
}
switch(FEAT_TRAINS, SELF, sw_MK4_CARRIAGE_CC1_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_MK4_CARRIAGE_CC1_E; //All Gangways
	return spriteset_MK4_CARRIAGE_CC1_S;
}

switch(FEAT_TRAINS, SELF, sw_MK4_CARRIAGE_CC1_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_MK4_CARRIAGE_CC1_leftcheck; //All Gangways
	return sw_MK4_CARRIAGE_CC1_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_MK4_CARRIAGE_CC1, 8458) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_MK4_CARRIAGE_CC1); 
		introduction_date:				date(2000,1,1);
		model_life:						0;
		length:							8;
		
		weight: 						38 ton;
		speed:							140 mph;
		cost_factor: 					0xA8 nfo;
		running_cost_factor: 			0x4F nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		variant_group: 			        ITEM_FAI_PW_MK4_CARRIAGE;
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					60;
		loading_speed:					5;
		
	}
	graphics {
		default:						sw_MK4_CARRIAGE_CC1_rightcheck;
		purchase:						spriteset_MK4_CARRIAGE_CC1_purchase;
	}
}
