//Sprite References & Switches
spriteset(spriteset_SLAM_DOOR_CARRIAGE_0_purchase, "gfx/PW/SLAM_DOOR_CARRIAGE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_SLAM_DOOR_CARRIAGE_0, "gfx/PW/SLAM_DOOR_CARRIAGE.png") { template_fai_33(0, 16)}
spriteset(spriteset_SLAM_DOOR_CARRIAGE_0_F, "gfx/PW/SLAM_DOOR_CARRIAGE.png") { template_fai_33(0, 41)}
spriteset(spriteset_SLAM_DOOR_CARRIAGE_0_E, "gfx/PW/SLAM_DOOR_CARRIAGE.png") { template_fai_33_r(0, 41)}
spriteset(spriteset_SLAM_DOOR_CARRIAGE_0_S, "gfx/PW/SLAM_DOOR_CARRIAGE.png") { template_fai_33(0, 16)}
switch(FEAT_TRAINS, SELF, sw_SLAM_DOOR_CARRIAGE_0_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_SLAM_DOOR_CARRIAGE_0; //All Gangways
	return spriteset_SLAM_DOOR_CARRIAGE_0_F;
}
switch(FEAT_TRAINS, SELF, sw_SLAM_DOOR_CARRIAGE_0_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_SLAM_DOOR_CARRIAGE_0_E; //All Gangways
	return spriteset_SLAM_DOOR_CARRIAGE_0_S;
}

switch(FEAT_TRAINS, SELF, sw_SLAM_DOOR_CARRIAGE_0_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_SLAM_DOOR_CARRIAGE_0_leftcheck; //All Gangways
	return sw_SLAM_DOOR_CARRIAGE_0_leftcheck_noright;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_PW_SLAM_DOOR_CARRIAGE_0, 7869) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		
		name:							string(STR_NAME_SLAM_DOOR_CARRIAGE_0); 
		introduction_date:				date(1974,1,1);
		model_life:						20;
		length:							8;
		
		weight: 						30 ton;
		speed:							90 mph;
		cost_factor: 					0x91 nfo;
		running_cost_factor: 			0x4E nfo;
		
		badges: ["flag/GB", "feature/gangway"];
		
		variant_group: 			        ITEM_FAI_PW_SLAM_DOOR_CARRIAGE;
		
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
		non_refittable_cargo_classes:		bitmask();
		default_cargo_type:				PASS;
		cargo_capacity:					58;
		loading_speed:					4;
		
	}
	graphics {
		default:						sw_SLAM_DOOR_CARRIAGE_0_rightcheck;
		purchase:						spriteset_SLAM_DOOR_CARRIAGE_0_purchase;
	}
}
