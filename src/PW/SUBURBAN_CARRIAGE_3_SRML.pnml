switch(FEAT_TRAINS, SELF, sw_SUBURBAN_CARRIAGE_3_SRML_leftcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_SUBURBAN_CARRIAGE_3_SRML; //All Gangways
	return spriteset_SUBURBAN_CARRIAGE_3_SRML_F;
}
switch(FEAT_TRAINS, SELF, sw_SUBURBAN_CARRIAGE_3_SRML_leftcheck_noright, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: spriteset_SUBURBAN_CARRIAGE_3_SRML_E; //All Gangways
	return spriteset_SUBURBAN_CARRIAGE_3_SRML_S;
}

switch(FEAT_TRAINS, SELF, sw_SUBURBAN_CARRIAGE_3_SRML_rightcheck, [STORE_TEMP(badgetype("feature/gangway"), 0x10E), STORE_TEMP(1, 0x10F), var[0x61, 0, 0x00000001, 0x7A]]){
	1: sw_SUBURBAN_CARRIAGE_3_SRML_leftcheck; //All Gangways
	return sw_SUBURBAN_CARRIAGE_3_SRML_leftcheck_noright;
}

