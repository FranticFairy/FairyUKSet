badgetable {
    "flag/GB",
	"feature/gangway",
	"power/steam",
	"power/diesel",
	"power/electric",
	"power/third_rail",
	"power/dual_voltage",
	"power/turbine",
	"power/fourth_rail",
	"role/light_mixed",
	"role/mixed",
	"role/light_passenger",
	"role/passenger",
	"role/express_passenger",
	"role/shunting",
	"role/light_freight",
	"role/freight",
	"role/express_freight",
	"role/heavy_freight",
	"role/mail",
}

template template_fai_badge(x, y) {
    //[left_x, upper_y, width, height, offset_x, offset_y]
    [x , y, 52, 12, -28, -8, ANIM]
}
spriteset(sprite_badge_steam, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/badges.png") { template_fai_badge(0,0) }
spriteset(sprite_badge_diesel, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/badges.png") { template_fai_badge(0,13) }
spriteset(sprite_badge_elrl, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/badges.png") { template_fai_badge(0,26) }
spriteset(sprite_badge_thir, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/badges.png") { template_fai_badge(0,39) }
spriteset(sprite_badge_duvo, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/badges.png") { template_fai_badge(0,52) }
spriteset(sprite_badge_trbn, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/badges.png") { template_fai_badge(0,65) }
spriteset(sprite_badge_mtro, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/badges.png") { template_fai_badge(0,78) }

item (FEAT_BADGES, feature) {
    property {
        label: "feature";
    }
}

item (FEAT_BADGES, gangway) {
    property {
        label: "feature/gangway";
    }
}

item (FEAT_BADGES, power) {
    property {
        label: "power";
        name: string(STR_POWER);
    }
}

item (FEAT_BADGES, steam) {
    property {
        label: "power/steam";
        name: string(STR_POWER_STEAM);
    }
    graphics {
        default: sprite_badge_steam;
    }
}

