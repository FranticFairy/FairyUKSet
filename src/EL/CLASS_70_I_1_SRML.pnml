		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x11 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NBA3;
		running_cost_base:				RUNNING_COST_ELECTRIC;
		engine_class: 					ENGINE_CLASS_ELECTRIC;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_CLASS_70_I_1_SRML); 
		introduction_date:				date(1941,1,1);
		vehicle_life: 					35;
		model_life:						28;
		length:							7;
		
		weight: 						101 ton;
		speed:							75 mph;
		power:							1470 hp;
		tractive_effort_coefficient: 	0.1798343;
		cost_factor: 					0x25 nfo;
		running_cost_factor: 			0x21 nfo;
		
		badges: ["flag/GB", "power/third_rail", "role/mixed"];
		
		variant_group: 			        ITEM_FAI_EL_CLASS_70_I_1;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CLASS_70_I_1_SRML_randomflip;
		sound_effect:					sw_sfx_EL1;
		purchase:						spriteset_CLASS_70_I_1_SRML_purchase;
		create_effect:					vfx_3rd;
	}
}
