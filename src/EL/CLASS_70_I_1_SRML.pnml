//Sprite References & Switches
spriteset(spriteset_CLASS_70_I_1_SRML_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_CLASS_70_I_1_SRML_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/EL/CLASS_70_I_1_SRML.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_CLASS_70_I_1_SRML, "gfx/32bpp.png") { template_fai_29(0, 16)}
alternative_sprites(spriteset_CLASS_70_I_1_SRML, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/EL/CLASS_70_I_1_SRML.png") { template_fai_29(0, 16)}
spriteset(spriteset_CLASS_70_I_1_SRML_flip, "gfx/32bpp.png") { template_fai_29_r(0, 16)}
alternative_sprites(spriteset_CLASS_70_I_1_SRML_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/EL/CLASS_70_I_1_SRML.png") { template_fai_29_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_CLASS_70_I_1_SRML_flipcheck, vehicle_is_reversed){
	1: spriteset_CLASS_70_I_1_SRML;
	spriteset_CLASS_70_I_1_SRML_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_CLASS_70_I_1_SRML_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_CLASS_70_I_1_SRML_flip;
	spriteset_CLASS_70_I_1_SRML ;
}

random_switch (FEAT_TRAINS, SELF, sw_CLASS_70_I_1_SRML_randomflip) {
	1: sw_CLASS_70_I_1_SRML_flipcheck;
	1: sw_CLASS_70_I_1_SRML_flipcheck_inv;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_EL_CLASS_70_I_1_SRML, 5176) {
