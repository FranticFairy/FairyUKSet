//Sprite References & Switches
spriteset(spriteset_PATRIOT_LMSC_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_PATRIOT_LMSC_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/PATRIOT_LMSC.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_PATRIOT_LMSC, "gfx/32bpp.png") { template_fai_24(0, 16)}
alternative_sprites(spriteset_PATRIOT_LMSC, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/PATRIOT_LMSC.png") { template_fai_24(0, 16)}
spriteset(spriteset_PATRIOT_LMSC_tender_0, "gfx/32bpp.png") { template_fai_13(0, 41)}
alternative_sprites(spriteset_PATRIOT_LMSC_tender_0, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/PATRIOT_LMSC.png") { template_fai_13(0, 41)}

switch(FEAT_TRAINS, SELF, sw_PATRIOT_LMSC_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_PATRIOT_LMSC, 1884) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0E nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_PATRIOT_LMSC); 
		introduction_date:				date(1930,1,1);
		vehicle_life: 					30;
		model_life:						36;
		length:							6;
		
		weight: 						125 ton;
		speed:							90 mph;
		power:							1750 hp;
		tractive_effort_coefficient: 	0.09632653;
		cost_factor: 					0x26 nfo;
		running_cost_factor: 			0x4E nfo;
		
		badges: ["flag/GB", "power/steam", "role/express_passenger"];
		
		variant_group: 			        ITEM_FAI_SL_PATRIOT;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_PATRIOT_LMSC;
		sound_effect:					sw_sfx_LMS;
		purchase:						spriteset_PATRIOT_LMSC_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_PATRIOT_LMSC_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_PATRIOT_LMSC_tender_0;
		length: 						3;
	}
}
