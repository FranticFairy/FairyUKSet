//Sprite References & Switches
spriteset(spriteset_USA_TANK_NBR_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_USA_TANK_NBR_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/USA_TANK_NBR.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_USA_TANK_NBR, "gfx/32bpp.png") { template_fai_21(0, 16)}
alternative_sprites(spriteset_USA_TANK_NBR, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/USA_TANK_NBR.png") { template_fai_21(0, 16)}
spriteset(spriteset_USA_TANK_NBR_flip, "gfx/32bpp.png") { template_fai_21_r(0, 16)}
alternative_sprites(spriteset_USA_TANK_NBR_flip, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/USA_TANK_NBR.png") { template_fai_21_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_USA_TANK_NBR_flipcheck, vehicle_is_reversed){
	1: spriteset_USA_TANK_NBR;
	spriteset_USA_TANK_NBR_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_USA_TANK_NBR_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_USA_TANK_NBR_flip;
	spriteset_USA_TANK_NBR ;
}

random_switch (FEAT_TRAINS, SELF, sw_USA_TANK_NBR_randomflip) {
	1: sw_USA_TANK_NBR_flipcheck;
	1: sw_USA_TANK_NBR_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_USA_TANK_NBR_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_USA_TANK_NBR_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_USA_TANK_NBR_randomflip_steam) {
	dependent:	sw_USA_TANK_NBR_randomflip;
	1: sw_USA_TANK_NBR_flipcheck_steam_inv;
	1: sw_USA_TANK_NBR_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_USA_TANK_NBR, 952) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x19 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_USA_TANK_NBR); 
		introduction_date:				date(1942,1,1);
		vehicle_life: 					25;
		model_life:						26;
		length:							5;
		
		weight: 						45 ton;
		speed:							50 mph;
		power:							500 hp;
		tractive_effort_coefficient: 	0.2176871;
		cost_factor: 					0x0C nfo;
		running_cost_factor: 			0x08 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_freight"];
		
		variant_group: 			        ITEM_FAI_SL_USA_TANK;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_USA_TANK_NBR_randomflip;
		visual_effect_and_powered:		sw_USA_TANK_NBR_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_USA_TANK_NBR_purchase;
		create_effect:					vfx_STEAM;
	}
}
