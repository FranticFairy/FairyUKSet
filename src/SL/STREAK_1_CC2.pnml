//Sprite References & Switches
spriteset(spriteset_STREAK_1_CC2_purchase, "gfx/SL/STREAK_1_CC2.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_STREAK_1_CC2, "gfx/SL/STREAK_1_CC2.png") { template_fai_29(0, 16)}
spriteset(spriteset_STREAK_1_CC2_tender_0, "gfx/SL/STREAK_1_CC2.png") { template_fai_16(0, 41)}

switch(FEAT_TRAINS, SELF, sw_STREAK_1_CC2_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_STREAK_1_CC2, 1956) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0B nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_STREAK_1_CC2); 
		introduction_date:				date(1935,1,1);
		vehicle_life: 					30;
		model_life:						31;
		length:							7;
		
		weight: 						166 ton;
		speed:							115 mph;
		power:							2000 hp;
		tractive_effort_coefficient: 	0.09773789;
		cost_factor: 					0x2A nfo;
		running_cost_factor: 			0x70 nfo;
		
		badges: ["flag/GB", "power/steam", "role/express_passenger"];
		
		variant_group: 			        ITEM_FAI_SL_STREAK_1;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_STREAK_1_CC2;
		sound_effect:					sw_sfx_A4;
		purchase:						spriteset_STREAK_1_CC2_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_STREAK_1_CC2_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_STREAK_1_CC2_tender_0;
		length: 						4;
	}
}
