//Sprite References & Switches
spriteset(spriteset_WELSH_purchase, "gfx/SL/PITWORKER.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_WELSH, "gfx/SL/PITWORKER.png") { template_fai_25(0, 16)}
spriteset(spriteset_WELSH_flip, "gfx/SL/PITWORKER.png") { template_fai_25_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_WELSH_flipcheck, vehicle_is_reversed){
	1: spriteset_WELSH;
	spriteset_WELSH_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_WELSH_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_WELSH_flip;
	spriteset_WELSH ;
}

random_switch (FEAT_TRAINS, SELF, sw_WELSH_randomflip) {
	1: sw_WELSH_flipcheck;
	1: sw_WELSH_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_WELSH_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_WELSH_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_WELSH_randomflip_steam) {
	dependent:	sw_WELSH_randomflip;
	1: sw_WELSH_flipcheck_steam_inv;
	1: sw_WELSH_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_WELSH, 800) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x20 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_WELSH); 
		introduction_date:				date(1904,1,1);
		vehicle_life: 					25;
		model_life:						31;
		length:							6;
		
		weight: 						63 ton;
		speed:							40 mph;
		power:							500 hp;
		tractive_effort_coefficient: 	0.1765468;
		cost_factor: 					0x0E nfo;
		running_cost_factor: 			0x14 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_freight"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_WELSH_randomflip;
		visual_effect_and_powered:		sw_WELSH_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_WELSH_purchase;
		create_effect:					vfx_STEAM;
	}
}
