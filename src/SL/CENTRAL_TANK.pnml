//Sprite References & Switches
spriteset(spriteset_CENTRAL_TANK_purchase, "gfx/SL/CENTRAL_TANK.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_CENTRAL_TANK, "gfx/SL/CENTRAL_TANK.png") { template_fai_29(0, 16)}
spriteset(spriteset_CENTRAL_TANK_flip, "gfx/SL/CENTRAL_TANK.png") { template_fai_29_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_CENTRAL_TANK_flipcheck, vehicle_is_reversed){
	1: spriteset_CENTRAL_TANK;
	spriteset_CENTRAL_TANK_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_CENTRAL_TANK_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_CENTRAL_TANK_flip;
	spriteset_CENTRAL_TANK ;
}

random_switch (FEAT_TRAINS, SELF, sw_CENTRAL_TANK_randomflip) {
	1: sw_CENTRAL_TANK_flipcheck;
	1: sw_CENTRAL_TANK_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_CENTRAL_TANK_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_CENTRAL_TANK_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_CENTRAL_TANK_randomflip_steam) {
	dependent:	sw_CENTRAL_TANK_randomflip;
	1: sw_CENTRAL_TANK_flipcheck_steam_inv;
	1: sw_CENTRAL_TANK_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_CENTRAL_TANK, 488) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x19 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_CENTRAL_TANK); 
		introduction_date:				date(1911,1,1);
		vehicle_life: 					25;
		model_life:						46;
		length:							7;
		
		weight: 						87 ton;
		speed:							50 mph;
		power:							850 hp;
		tractive_effort_coefficient: 	0.1231527;
		cost_factor: 					0x10 nfo;
		running_cost_factor: 			0x19 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_passenger"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_CENTRAL_TANK_randomflip;
		visual_effect_and_powered:		sw_CENTRAL_TANK_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_CENTRAL_TANK_purchase;
		create_effect:					vfx_STEAM;
	}
}
