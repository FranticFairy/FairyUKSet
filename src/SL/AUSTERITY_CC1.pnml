//Sprite References & Switches
spriteset(spriteset_AUSTERITY_CC1_purchase, "gfx/SL/AUSTERITY_CC1.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_AUSTERITY_CC1, "gfx/SL/AUSTERITY_CC1.png") { template_fai_21(0, 16)}
spriteset(spriteset_AUSTERITY_CC1_tender_0, "gfx/SL/AUSTERITY_CC1.png") { template_fai_12(0, 41)}

switch(FEAT_TRAINS, SELF, sw_AUSTERITY_CC1_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_AUSTERITY_CC1, 2722) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x14 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_AUSTERITY_CC1); 
		introduction_date:				date(1942,1,1);
		vehicle_life: 					30;
		model_life:						24;
		length:							5;
		
		weight: 						90 ton;
		speed:							65 mph;
		power:							1000 hp;
		tractive_effort_coefficient: 	0.1485261;
		cost_factor: 					0x14 nfo;
		running_cost_factor: 			0x21 nfo;
		
		badges: ["flag/GB", "power/steam", "role/freight"];
		
		variant_group: 			        ITEM_FAI_SL_AUSTERITY;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_AUSTERITY_CC1;
		sound_effect:					sw_sfx_LMS;
		purchase:						spriteset_AUSTERITY_CC1_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_AUSTERITY_CC1_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_AUSTERITY_CC1_tender_0;
		length: 						3;
	}
}
