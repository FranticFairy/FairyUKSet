//Sprite References & Switches
spriteset(spriteset_KIRTLEY_RCC_purchase, "gfx/SL/KIRTLEY_RCC.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_KIRTLEY_RCC, "gfx/SL/KIRTLEY_RCC.png") { template_fai_17(0, 16)}
spriteset(spriteset_KIRTLEY_RCC_tender_0, "gfx/SL/KIRTLEY_RCC.png") { template_fai_12(0, 41)}

switch(FEAT_TRAINS, SELF, sw_KIRTLEY_RCC_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_KIRTLEY_RCC, 1137) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x14 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_KIRTLEY_RCC); 
		introduction_date:				date(1866,1,1);
		vehicle_life: 					25;
		model_life:						19;
		length:							4;
		
		weight: 						68 ton;
		speed:							65 mph;
		power:							500 hp;
		tractive_effort_coefficient: 	0.08103241;
		cost_factor: 					0x0C nfo;
		running_cost_factor: 			0x0A nfo;
		
		badges: ["flag/GB", "power/steam", "role/passenger"];
		
		variant_group: 			        ITEM_FAI_SL_KIRTLEY;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_KIRTLEY_RCC;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_KIRTLEY_RCC_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_KIRTLEY_RCC_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_KIRTLEY_RCC_tender_0;
		length: 						3;
	}
}
