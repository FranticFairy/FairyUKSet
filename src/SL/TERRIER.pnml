//Sprite References & Switches
spriteset(spriteset_TERRIER_purchase, "gfx/SL/TERRIER.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_TERRIER, "gfx/SL/TERRIER.png") { template_fai_21(0, 16)}
spriteset(spriteset_TERRIER_flip, "gfx/SL/TERRIER.png") { template_fai_21_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_TERRIER_flipcheck, vehicle_is_reversed){
	1: spriteset_TERRIER;
	spriteset_TERRIER_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_TERRIER_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_TERRIER_flip;
	spriteset_TERRIER ;
}

random_switch (FEAT_TRAINS, SELF, sw_TERRIER_randomflip) {
	1: sw_TERRIER_flipcheck;
	1: sw_TERRIER_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_TERRIER_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_TERRIER_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_TERRIER_randomflip_steam) {
	dependent:	sw_TERRIER_randomflip;
	1: sw_TERRIER_flipcheck_steam_inv;
	1: sw_TERRIER_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_TERRIER, 344) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x1C nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_TERRIER); 
		introduction_date:				date(1872,1,1);
		vehicle_life: 					40;
		model_life:						95;
		length:							5;
		
		weight: 						27 ton;
		speed:							45 mph;
		power:							300 hp;
		tractive_effort_coefficient: 	0.1284958;
		cost_factor: 					0x0F nfo;
		running_cost_factor: 			0x10 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_passenger"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_TERRIER_randomflip;
		visual_effect_and_powered:		sw_TERRIER_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_TERRIER_purchase;
		create_effect:					vfx_STEAM;
	}
}
