//Sprite References & Switches
spriteset(spriteset_CASTLE_purchase, "gfx/SL/CASTLE.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_CASTLE, "gfx/SL/CASTLE.png") { template_fai_27(0, 16)}
spriteset(spriteset_CASTLE_tender_0, "gfx/SL/CASTLE.png") { template_fai_14(0, 41)}

switch(FEAT_TRAINS, SELF, sw_CASTLE_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_CASTLE, 1760) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x0D nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_CASTLE); 
		introduction_date:				date(1923,1,1);
		vehicle_life: 					30;
		model_life:						43;
		length:							6;
		
		weight: 						129 ton;
		speed:							100 mph;
		power:							1500 hp;
		tractive_effort_coefficient: 	0.110742;
		cost_factor: 					0x25 nfo;
		running_cost_factor: 			0x46 nfo;
		
		badges: ["flag/GB", "power/steam", "role/express_passenger"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_CASTLE;
		sound_effect:					sw_sfx_QR;
		purchase:						spriteset_CASTLE_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_CASTLE_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_CASTLE_tender_0;
		length: 						4;
	}
}
