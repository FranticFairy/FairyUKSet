//Sprite References & Switches
spriteset(spriteset_JAZZER_LMSC_purchase, "gfx/32bpp.png") { template_fai_purchase(0, 0)}
alternative_sprites(spriteset_JAZZER_LMSC_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/JAZZER_LMSC.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_JAZZER_LMSC, "gfx/32bpp.png") { template_fai_25(0, 16)}
alternative_sprites(spriteset_JAZZER_LMSC, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/JAZZER_LMSC.png") { template_fai_25(0, 16)}
spriteset(spriteset_JAZZER_LMSC_tender_0, "gfx/32bpp.png") { template_fai_12(0, 41)}
alternative_sprites(spriteset_JAZZER_LMSC_tender_0, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SL/JAZZER_LMSC.png") { template_fai_12(0, 41)}

switch(FEAT_TRAINS, SELF, sw_JAZZER_LMSC_articulation, extra_callback_info1) {
    1: return ITEM_WAGON_FAI_TENDER_0;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_JAZZER_LMSC, 1068) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x15 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_JAZZER_LMSC); 
		introduction_date:				date(1920,1,1);
		vehicle_life: 					36;
		model_life:						42;
		length:							6;
		
		weight: 						123 ton;
		speed:							60 mph;
		power:							1100 hp;
		tractive_effort_coefficient: 	0.1103368;
		cost_factor: 					0x1C nfo;
		running_cost_factor: 			0x28 nfo;
		
		badges: ["flag/GB", "power/steam", "role/mixed"];
		
		variant_group: 			        ITEM_FAI_SL_JAZZER;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						spriteset_JAZZER_LMSC;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_JAZZER_LMSC_purchase;
		create_effect:					vfx_STEAM;
		visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
		articulated_part:				sw_JAZZER_LMSC_articulation;
	}
	livery_override (ITEM_WAGON_FAI_TENDER_0) {
		default: 						spriteset_JAZZER_LMSC_tender_0;
		length: 						3;
	}
}
