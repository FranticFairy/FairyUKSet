//Sprite References & Switches
spriteset(spriteset_PITWORKER_RCC_purchase, "gfx/SL/PITWORKER_RCC.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_PITWORKER_RCC, "gfx/SL/PITWORKER_RCC.png") { template_fai_25(0, 16)}
spriteset(spriteset_PITWORKER_RCC_flip, "gfx/SL/PITWORKER_RCC.png") { template_fai_25_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_PITWORKER_RCC_flipcheck, vehicle_is_reversed){
	1: spriteset_PITWORKER_RCC;
	spriteset_PITWORKER_RCC_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_PITWORKER_RCC_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_PITWORKER_RCC_flip;
	spriteset_PITWORKER_RCC ;
}

random_switch (FEAT_TRAINS, SELF, sw_PITWORKER_RCC_randomflip) {
	1: sw_PITWORKER_RCC_flipcheck;
	1: sw_PITWORKER_RCC_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_PITWORKER_RCC_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_PITWORKER_RCC_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_PITWORKER_RCC_randomflip_steam) {
	dependent:	sw_PITWORKER_RCC_randomflip;
	1: sw_PITWORKER_RCC_flipcheck_steam_inv;
	1: sw_PITWORKER_RCC_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_PITWORKER_RCC, 897) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x1C nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		extra_flags:				    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_CARGO;
		
		name:							string(STR_NAME_PITWORKER_RCC); 
		introduction_date:				date(1924,1,1);
		vehicle_life: 					25;
		model_life:						38;
		length:							6;
		
		weight: 						69 ton;
		speed:							45 mph;
		power:							500 hp;
		tractive_effort_coefficient: 	0.170068;
		cost_factor: 					0x0E nfo;
		running_cost_factor: 			0x10 nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_freight"];
		
		variant_group: 			        ITEM_FAI_SL_PITWORKER;
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_PITWORKER_RCC_randomflip;
		visual_effect_and_powered:		sw_PITWORKER_RCC_randomflip_steam;
		sound_effect:					sw_sfx_JIN;
		purchase:						spriteset_PITWORKER_RCC_purchase;
		create_effect:					vfx_STEAM;
	}
}
