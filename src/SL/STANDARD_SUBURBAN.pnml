//Sprite References & Switches
spriteset(spriteset_STANDARD_SUBURBAN_purchase, "gfx/SL/SUBURBAN_II.png") { template_fai_purchase(0, 0)}

spriteset(spriteset_STANDARD_SUBURBAN, "gfx/SL/SUBURBAN_II.png") { template_fai_29(0, 16)}
spriteset(spriteset_STANDARD_SUBURBAN_flip, "gfx/SL/SUBURBAN_II.png") { template_fai_29_r(0, 16)}

switch(FEAT_TRAINS, PARENT, sw_STANDARD_SUBURBAN_flipcheck, vehicle_is_reversed){
	1: spriteset_STANDARD_SUBURBAN;
	spriteset_STANDARD_SUBURBAN_flip ;
}

switch(FEAT_TRAINS, PARENT, sw_STANDARD_SUBURBAN_flipcheck_inv, vehicle_is_reversed){
	1: spriteset_STANDARD_SUBURBAN_flip;
	spriteset_STANDARD_SUBURBAN ;
}

random_switch (FEAT_TRAINS, SELF, sw_STANDARD_SUBURBAN_randomflip) {
	1: sw_STANDARD_SUBURBAN_flipcheck;
	1: sw_STANDARD_SUBURBAN_flipcheck_inv;
}

switch(FEAT_TRAINS, PARENT, sw_STANDARD_SUBURBAN_flipcheck_steam, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER) ;
}

switch(FEAT_TRAINS, PARENT, sw_STANDARD_SUBURBAN_flipcheck_steam_inv, vehicle_is_reversed){
	1: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, ENABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, ENABLE_WAGON_POWER) ;
}

random_switch (FEAT_TRAINS, SELF, sw_STANDARD_SUBURBAN_randomflip_steam) {
	dependent:	sw_STANDARD_SUBURBAN_randomflip;
	1: sw_STANDARD_SUBURBAN_flipcheck_steam_inv;
	1: sw_STANDARD_SUBURBAN_flipcheck_steam;
}

//Vehicle
item (FEAT_TRAINS, ITEM_FAI_SL_STANDARD_SUBURBAN, 632) {
	property {
		sprite_id:						SPRITE_ID_NEW_TRAIN;
		refit_cost:						0;
		climates_available:				ALL_CLIMATES;
		bitmask_vehicle_info:			0;
		air_drag_coefficient:			0x12 nfo;
		misc_flags:						bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
		
		track_type:						NGRL;
		running_cost_base:				RUNNING_COST_STEAM;
		engine_class: 					ENGINE_CLASS_STEAM;
		ai_special_flag:				AI_FLAG_PASSENGER;
		
		name:							string(STR_NAME_STANDARD_SUBURBAN); 
		introduction_date:				date(1951,1,1);
		vehicle_life: 					35;
		model_life:						11;
		length:							7;
		
		weight: 						88 ton;
		speed:							70 mph;
		power:							1200 hp;
		tractive_effort_coefficient: 	0.1310297;
		cost_factor: 					0x1A nfo;
		running_cost_factor: 			0x2C nfo;
		
		badges: ["flag/GB", "power/steam", "role/light_passenger"];
		
		cargo_capacity: 				0;
	}
	graphics {
		default:						sw_STANDARD_SUBURBAN_randomflip;
		visual_effect_and_powered:		sw_STANDARD_SUBURBAN_randomflip_steam;
		sound_effect:					sw_sfx_QR;
		purchase:						spriteset_STANDARD_SUBURBAN_purchase;
		create_effect:					vfx_STEAM;
	}
}
